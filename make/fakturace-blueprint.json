                        "name": "datum_vystaveni",
                        "value": "{{formatDate(now; \"D.M.YYYY\")}}"
                    },
                    {
                        "name": "datum_splatnosti",
                        "value": "{{formatDate(parseDate(1.splatnost); \"D.M.YYYY\")}}"
                    },
                    {
                        "name": "variabilni_symbol",
                        "value": "{{3.data.variabilni_symbol}}"
                    },
                    {
                        "name": "castka_text",
                        "value": "500 Kč"
                    },
                    {
                        "name": "odberatel_nazev",
                        "value": "{{ifempty(3.data.fakt_nazev; 3.data.kontaktni_osoba)}}"
                    },
                    {
                        "name": "odberatel_adresa",
                        "value": "{{ifempty(3.data.fakt_adresa; \"\")}}"
                    },
                    {
                        "name": "odberatel_ic",
                        "value": "{{ifempty(3.data.fakt_ic; \"—\")}}"
                    },
                    {
                        "name": "odberatel_dic",
                        "value": "{{ifempty(3.data.fakt_dic; \"—\")}}"
                    }
                ],
                "scope": "roundtrip"
            },
            "metadata": {
                "designer": {
                    "x": 1200,
                    "y": 0,
                    "name": "5. Sestavení faktury – odvozené údaje"
                },
                "restore": {
                    "expect": {
                        "variables": {
                            "mode": "chose"
                        },
                        "scope": {
                            "label": "Jeden běh scénáře"
                        }
                    }
                },
                "expect": [
                    {
                        "name": "variables",
                        "type": "array",
                        "label": "Proměnné"
                    },
                    {
                        "name": "scope",
                        "type": "select",
                        "label": "Platnost proměnné"
                    }
                ],
                "notes": "Připraví hodnoty, které se dosazují do šablony faktury. Číslo faktury (26/03/100001) končí variabilním symbolem, takže název souboru vyjde faktura-26-03-100001.pdf a je z něj poznat, ke které platbě patří. Datum splatnosti se NEPOČÍTÁ znovu – bere se hotové z webhooku (pole splatnost), aby na faktuře bylo stejné datum jako v QR kódu k platbě. Splatnost (dnes + 7 dní) počítá Edge Function; když ji chceš změnit, mění se tam, ne tady. Proměnná splatnost_dnu v modulu 2 je jen informativní, na výpočet nemá vliv."
            }
        },
