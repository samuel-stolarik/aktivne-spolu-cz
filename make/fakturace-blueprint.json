{
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": null,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0,
                    "name": "1. Webhook – přihláška k vyfakturování"
                },
                "restore": {
                    "parameters": {
                        "hook": {
                            "data": {
                                "editable": "true"
                            },
                            "label": "aktivne-spolu – fakturace (po importu vytvoř NOVÝ webhook)"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "hook",
                        "type": "hook",
                        "label": "Webhook",
                        "required": true,
                        "spec": []
                    },
                    {
                        "name": "maxResults",
                        "type": "number",
                        "label": "Maximální počet výsledků"
                    }
                ],
                "interface": [
                    {
                        "name": "id",
                        "type": "text",
                        "label": "ID přihlášky v tabulce public.prihlasky (uuid)"
                    },
                    {
                        "name": "variabilni_symbol",
