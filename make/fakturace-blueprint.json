                        "label": "Variabilní symbol přidělený Supabase"
                    },
                    {
                        "name": "castka_kc",
                        "type": "number",
                        "label": "Částka v Kč"
                    },
                    {
                        "name": "splatnost",
                        "type": "text",
                        "label": "Datum splatnosti (ISO, už spočítané = dnes + 7 dní)"
                    },
                    {
                        "name": "qr_url",
                        "type": "text",
                        "label": "Odkaz na QR kód k platbě"
                    },
                    {
                        "name": "spayd",
                        "type": "text",
                        "label": "Řetězec SPAYD pro QR platbu"
                    },
                    {
                        "name": "email_odeslan",
                        "type": "boolean",
                        "label": "Jestli už odešel potvrzovací e-mail"
                    },
                    {
                        "name": "forma_platby",
                        "type": "text",
                        "label": "Forma platby – jen 'qr' nebo 'prevod'"
                    },
                    {
                        "name": "email",
                        "type": "text",
                        "label": "E-mail přihlašujícího (jen pro kontrolu, závazný je údaj ze Supabase)"
                    },
                    {
                        "name": "typ_poradatele",
                        "type": "text",
                        "label": "Typ pořadatele"
                    },
                    {
                        "name": "nazev_poradatele",
                        "type": "text",
                        "label": "Název pořadatele"
                    },
                    {
                        "name": "kontaktni_osoba",
                        "type": "text",
                        "label": "Kontaktní osoba"
                    },
                    {
                        "name": "telefon",
                        "type": "text",
                        "label": "Telefon"
                    },
                    {
                        "name": "mesto",
                        "type": "text",
                        "label": "Město"
                    },
                    {
                        "name": "kraj",
                        "type": "text",
                        "label": "Kraj"
                    },
                    {
                        "name": "napad_na_aktivitu",
                        "type": "text",
                        "label": "Nápad na aktivitu"
                    },
                    {
                        "name": "fakt_nazev",
                        "type": "text",
                        "label": "Fakturační název"
                    },
                    {
                        "name": "fakt_adresa",
                        "type": "text",
                        "label": "Fakturační adresa"
                    },
                    {
                        "name": "fakt_ic",
                        "type": "text",
                        "label": "IČ odběratele"
                    },
                    {
                        "name": "fakt_dic",
                        "type": "text",
                        "label": "DIČ odběratele"
                    },
                    {
                        "name": "souhlas_gdpr",
                        "type": "boolean",
                        "label": "Souhlas GDPR"
                    }
                ],
                "notes": "Sem posílá data Edge Function po uložení přihlášky. POZOR: pole s ID přihlášky se jmenuje id, NE prihlaska_id – zdrojem pravdy je nasazená Edge Function, blueprint se přizpůsobuje jí. Tělo nese kompletní data přihlášky, ale fakturační údaje se stejně načítají znovu ze Supabase (modul 3), aby nešly podvrhnout z prohlížeče."
            }
        },
