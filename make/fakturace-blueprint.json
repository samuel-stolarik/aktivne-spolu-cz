        {
            "id": 8,
            "module": "google-email:ActionSendEmail",
            "version": 1,
            "parameters": {
                "account": null
            },
            "mapper": {
                "from": "{{2.odesilatel_email}}",
                "to": [
                    "{{3.data.email}}"
