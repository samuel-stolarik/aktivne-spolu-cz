        {
            "id": 7,
            "module": "google-docs:exportADocument",
            "version": 1,
            "parameters": {
                "__IMTCONN__": null
            },
            "mapper": {
                "destination": "drive",
                "document": "{{6.id}}",
                "mimeType": "application/pdf"
