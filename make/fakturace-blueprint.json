                        "type": "text",
                        "label": "Město"
                    },
                    {
                        "name": "kraj",
                        "type": "text",
                        "label": "Kraj"
                    },
                    {
                        "name": "napad_na_aktivitu",
                        "type": "text",
                        "label": "Nápad na aktivitu"
                    },
                    {
                        "name": "fakt_nazev",
                        "type": "text",
                        "label": "Fakturační název"
                    },
                    {
                        "name": "fakt_adresa",
                        "type": "text",
                        "label": "Fakturační adresa"
                    },
                    {
                        "name": "fakt_ic",
                        "type": "text",
                        "label": "IČ odběratele"
                    },
                    {
