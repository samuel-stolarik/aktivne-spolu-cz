# =============================================================================
# Nastavení projektu aktivne-spolu.cz
# =============================================================================
# Zkopíruj tenhle soubor jako `.env` a doplň hodnoty:
#
#     cp .env.example .env
#
# Soubor `.env` NIKDY nekomituj do gitu — jsou v něm klíče. Je zapsaný
# v .gitignore, tak to tak nech.
#
# Hodnoty označené [DOPLNIT: …] zatím nikdo nedodal. Web se s nimi sestaví
# a formulář poběží, ale dotčená část nebude fungovat — u každé je napsané,
# co konkrétně vypadne.
# =============================================================================


# --- Supabase: veřejná část --------------------------------------------------
# Tyhle dvě hodnoty se dostanou do prohlížeče každého návštěvníka. Je to
# v pořádku a tak to má být — anonymní klíč nemá k datům přihlášek žádný
# přístup (RLS je zapnuté a anon nemá na tabulku `prihlasky` žádná práva).
# Slouží jen k zavolání Edge Funkce.
PUBLIC_SUPABASE_URL=https://kourmwqxkhdtahbxyuaq.supabase.co
PUBLIC_SUPABASE_ANON_KEY=


# --- Supabase: servisní klíč -------------------------------------------------
# POZOR: obchází veškeré zabezpečení databáze. Nikdy nesmí skončit
# ve frontendu ani v gitu. Používá se jen lokálně a v Edge Funkcích,
# kde se nastavuje jako tajemství projektu, ne odsud.
SUPABASE_SERVICE_ROLE_KEY=


# =============================================================================
# Následující proměnné se nastavují jako tajemství Edge Funkce v Supabase,
# ne v tomhle souboru. Jsou tu vypsané, aby bylo na jednom místě vidět,
# co všechno projekt potřebuje:
#
#     npx supabase secrets set NAZEV=hodnota --project-ref kourmwqxkhdtahbxyuaq
# =============================================================================


# --- Platební údaje ----------------------------------------------------------
# Účet, na který chodí registrační poplatek 500 Kč.
# Ověřeno v ARESu 12. 8. 2026.
IBAN_UCTU=CZ2303000000000258492161
SWIFT_UCTU=CEKOCZPP
CISLO_UCTU=258492161/0300
ZPRAVA_PRO_PRIJEMCE=AKTIVNE SPOLU
CASTKA_POPLATKU=500
SPLATNOST_DNI=7


# --- Dodavatel na faktuře ----------------------------------------------------
# Právě teď! o.p.s. je NEPLÁTCE DPH (ARES: stavZdrojeDph = NEEXISTUJICI).
# Na faktuře proto není žádný rozpis daně, jen položka, částka a věta
# o neplátcovství. Pole pro DIČ dodavatele schválně neexistuje.
DODAVATEL_NAZEV=Právě teď! o.p.s.
DODAVATEL_ICO=29154901
DODAVATEL_ADRESA=Fügnerovo náměstí 1808/3, Nové Město, 120 00 Praha 2

# Zápis v rejstříku obecně prospěšných společností (spisová značka).
# Bez něj fakturu vystavit lze, ale chybí jí jedna z náležitostí.
DODAVATEL_ZAPIS_V_REJSTRIKU=[DOPLNIT: spisová značka u rejstříkového soudu]


# --- Číselná řada faktur -----------------------------------------------------
# Dvě číslice do prostřední části čísla faktury RR/SS/NNN (např. 26/03/001).
# Určuje účetní organizace. Bez ní se faktura nevystaví.
FAKTURY_CISLO_RADY=[DOPLNIT: dvoumístné interní číslo řady faktur]


# --- Odesílání e-mailů (Google Workspace) ------------------------------------
# Potvrzovací e-mail s platebními údaji a QR kódem chodí přes Gmail
# v Google Workspace zadavatele. Bez toho se přihláška uloží, ale
# potvrzení nikomu nepřijde.
GMAIL_ODESILATEL=[DOPLNIT: adresa, ze které se odesílá, např. info@aktivne-spolu.cz]
GMAIL_CLIENT_ID=[DOPLNIT: z Google Cloud Console]
GMAIL_CLIENT_SECRET=[DOPLNIT: z Google Cloud Console]
GMAIL_REFRESH_TOKEN=[DOPLNIT: vygenerovaný při autorizaci účtu]


# --- Fakturace přes Make -----------------------------------------------------
# Adresa webhooku scénáře v Make, který vystaví a odešle fakturu.
#
# Když je tahle proměnná prázdná nebo chybí, krok se PŘESKOČÍ BEZ CHYBY —
# přihláška se uloží a potvrzovací e-mail odejde, jen se nevystaví faktura.
# Je to schválně, aby web mohl běžet dřív, než je fakturace hotová.
#
# POZOR PO IMPORTU BLUEPRINTU: s blueprintem se webhook URL NEPŘENÁŠÍ.
# Po importu v cílovém účtu vznikne nová adresa a musí se sem přepsat.
# Když se na to zapomene, formulář poběží dál, lidem se zobrazí poděkování
# a faktury tiše nepojedou. Podrobnosti v make/README-make.md.
MAKE_WEBHOOK_URL=
