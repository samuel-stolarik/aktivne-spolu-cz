# Nastavení Edge Funkce prijmout-prihlasku.
#
# Tenhle soubor je VZOR. Zkopírujte ho na `.env`, doplňte hodnoty a nahrajte
# je do Supabase příkazem:
#
#     npx supabase secrets set --env-file supabase/functions/.env
#
# Soubor `.env` s vyplněnými hodnotami NIKDY nepatří do gitu.
# Sem, do vzoru, se skutečné hodnoty taky nepíšou.

# --- Platba ----------------------------------------------------------------

# Číslo účtu ve formátu IBAN. Z něj se skládá QR kód platby.
# Kontroluje se kontrolní číslicí (mod-97) — překlep se pozná a QR se radši
# nevyrobí, než aby posílal peníze jinam.
# Bez téhle hodnoty se QR kód přeskočí, ale přihláška se uloží normálně.
IBAN_UCTU="CZ2303000000000258492161"

# SWIFT (BIC) banky. Nepovinné — připojí se v platebním řetězci za IBAN,
# některé bankovní aplikace ho radši vidí. Když chybí nebo je rozbitý,
# QR se vyrobí jen s IBANem.
SWIFT_UCTU="CEKOCZPP"

# Totéž číslo účtu v běžném českém tvaru. Píše se do e-mailu, protože je
# čitelnější než IBAN. Když chybí, použije se do e-mailu IBAN.
CISLO_UCTU="258492161/0300"

# Jméno příjemce, které se zobrazí v bankovní aplikaci u QR platby.
NAZEV_PRIJEMCE="Právě teď! o.p.s."

# Zpráva pro příjemce u platby. Za ni se automaticky doplní variabilní symbol.
# Bez háčků a bez hvězdiček — platební řetězec ani bankovní aplikace si
# s diakritikou neporadí. Celá zpráva i s číslem se vejde do 60 znaků.
ZPRAVA_PLATBY="AKTIVNE SPOLU"

# Účastnický poplatek v korunách. Když se nevyplní, počítá se s 500 Kč.
CASTKA_KC="500"
# Za kolik dní od přihlášení má být zaplaceno. Promítne se do QR kódu
# (pole splatnosti) i do textu potvrzovacího e-mailu.
SPLATNOST_DNI="7"

# --- Odesílání potvrzovacích e-mailů (Gmail / Google Workspace) -------------
#
# Postup, jak tyhle čtyři hodnoty získat, je v supabase/README-supabase.md.
# Když kterákoli chybí, e-mail se přeskočí a přihláška se uloží tak jako tak.

GOOGLE_CLIENT_ID="[DOPLNIT: Client ID OAuth klienta z Google Cloud]"
GOOGLE_CLIENT_SECRET="[DOPLNIT: Client Secret OAuth klienta z Google Cloud]"
GOOGLE_REFRESH_TOKEN="[DOPLNIT: refresh token schránky, ze které pošta odchází]"

# Adresa, ze které potvrzení odchází. Musí to být schránka, která dala souhlas.
ODESILATEL_EMAIL="[DOPLNIT: e-mailová adresa odesílatele]"

# Jméno odesílatele, které uvidí příjemce. Nepovinné.
ODESILATEL_JMENO="[DOPLNIT: jméno odesílatele, např. Aktivně spolu]"

# --- Web -------------------------------------------------------------------

# Odkud smí formulář volat. Víc adres se odděluje čárkou.
# Když se nevyplní, přijímá se odkudkoli.
POVOLENE_ORIGINY="https://aktivne-spolu.cz,https://www.aktivne-spolu.cz"

# --- Fakturace (nepovinné) --------------------------------------------------

# Adresa, na kterou se pošle zpráva o nové přihlášce, aby se z ní dala
# vystavit faktura. Když je prázdná nebo chybí, krok se přeskočí bez chyby.
MAKE_WEBHOOK_URL=""
