---
/**
 * Zásobník nápadů — veřejný přehled schválených zápisů po akci.
 *
 * Data dodává Edge Funkce `verejne-napady` (jen schválené zápisy a jen
 * veřejná pole). Výběr běží v prohlížeči nad celým seznamem.
 *
 * Detail nápadu je na stejné stránce: /zasobnik/?id=<id>. Web je
 * statický, takže pro každý nápad nemůže existovat vlastní soubor.
 * Nadpis a pruh „Co tady můžete udělat" mění skript podle toho, jestli
 * je vidět přehled, nebo detail.
 *
 * Zadavatelka Zásobník odsouhlasila 18. 11. 2026 („pak už to pojďme
 * spustit"), proto je stránka veřejná a v sitemapě.
 *
 * Skript: src/components/zasobnik/prehled.ts
 */
import StrankaZasobniku from "../../layouts/StrankaZasobniku.astro";
---

<StrankaZasobniku
  titulek="Zásobník nápadů — mezigenerační akce | aktivně spolu"
  popis="Ověřené nápady na mezigenerační akce od škol, spolků a firem z celé republiky. Vyberte si a uspořádejte podobnou."
>
  <h1 class="z-nadpis" id="z-nadpis">Zásobník nápadů</h1>

  <div class="z-co-delat">
    <span class="z-co-delat-ikona" aria-hidden="true">i</span>
    <p>
      <strong>Co tady můžete udělat:</strong>{" "}<span id="z-co-delat">
        Vyberte (vyfiltrujte si), jakou aktivitu hledáte. Najdeme vám ověřené
        nápady od pořadatelů z celé republiky.
      </span>
    </p>
  </div>

  <div id="z-prehled">
    <div class="z-vyber" id="z-vyber" hidden></div>
    <div id="z-stav" aria-live="polite"></div>
    <div id="z-seznam">
      <p class="z-nacitani">Načítáme nápady…</p>
    </div>
  </div>

  <article id="z-detail" class="z-detail" hidden tabindex="-1"></article>
</StrankaZasobniku>

<script>
  import { spustPrehled } from "../../components/zasobnik/prehled";
  spustPrehled();
</script>
