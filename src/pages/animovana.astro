<script>
  // ==========================================================================
  // Animovaná verze — všechen pohyb na stránce
  //
  // JAK JE TO POSTAVENÉ
  //   * Odhalování při scrollu obsluhuje JEDEN IntersectionObserver. Prvek,
  //     který se odhalí, přestane sledovat — animace se proto neopakuje,
  //     když se návštěvník vrátí zpátky.
  //   * Všechno, co závisí na poloze scrollu (pruh postupu, paralaxa,
  //     přeliv plochy, spojnice kroků), počítá JEDNA smyčka svázaná
  //     s requestAnimationFrame. Ne každý efekt vlastní posluchač scrollu.
  //   * Reakce na myš má taky jednu smyčku a dohání kurzor se zpožděním,
  //     aby to nebylo trhané.
  //   * Hýbe se jen `transform` a `opacity`. Výjimkou je `stroke-dashoffset`
  //     u obrysových ilustrací, ten jinak animovat nejde.
  //
  // VYPNUTÝ POHYB
  //   Nic z toho se nespustí. Skrývání prvků visí na třídě `pohyb-ano`, která
  //   se v takovém případě na stránku vůbec nedostane (viz skript v šabloně),
  //   takže je od začátku všechno vidět na svém místě.
  // ==========================================================================

  const dotazNaPohyb = window.matchMedia("(prefers-reduced-motion: reduce)");
  const maMys = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  /** Srovná všechno do cílové polohy — používá se při vypnutí pohybu. */
  function odhalVsechno() {
    document
      .querySelectorAll<HTMLElement>(
        "[data-odhal], .podtrzeni, .kresli-se, .spendlik, .slovo, .pismeno, .balicek, .kruh-za-castkou",
      )
      .forEach((prvek) => prvek.classList.add("je-videt"));
  }

  // Když si návštěvník pohyb vypne až za běhu (třeba v nastavení systému),
  // třídu sundáme a obsah necháme viditelný. Nová animace se už nespustí.
  dotazNaPohyb.addEventListener("change", (u) => {
    if (!u.matches) return;
    document.documentElement.classList.remove("pohyb-ano");
    odhalVsechno();
  });

  if (dotazNaPohyb.matches) {
    // Pro jistotu i tady, kdyby CSS někdo v budoucnu upravil.
    odhalVsechno();
  } else {
    spustPohyb();
  }

  function spustPohyb() {
    // ------------------------------------------------------------------
    // Společný pozorovatel odhalování
    // ------------------------------------------------------------------
    const pozorovatel = new IntersectionObserver(
      (zaznamy) => {
        zaznamy.forEach((zaznam) => {
          if (!zaznam.isIntersecting) return;
          zaznam.target.classList.add("je-videt");
          pozorovatel.unobserve(zaznam.target);
        });
      },
      // Spustí se, až je prvek kousek uvnitř obrazovky, ne na její hraně.
      { rootMargin: "0px 0px -80px 0px", threshold: 0.1 },
    );

    function sleduj(vyber: string) {
      document
        .querySelectorAll<HTMLElement>(vyber)
        .forEach((prvek) => pozorovatel.observe(prvek));
    }

    // ------------------------------------------------------------------
    // ÚVOD, ANIMACE 1 — skládání nadpisu po písmenech a po slovech
    // ------------------------------------------------------------------
    // Text rozsekáme na slova; u varianty „po písmenech" ještě uvnitř slova
    // na jednotlivé znaky. Slovo zůstává vždycky pohromadě v jednom obalu,
    // aby se řádek nezalomil uprostřed slova.
    //
    // Zpoždění zapisujeme rovnou do `transition-delay`, ne přes stovky
    // časovačů — prohlížeč si kaskádu odbaví sám a levněji.
    (function slozNadpisy() {
      const rozsekej = (prvek: HTMLElement, poPismenech: boolean) => {
        const puvodni = prvek.textContent ?? "";
        const slova = puvodni.trim().split(/\s+/);
        prvek.textContent = "";

        let poradi = 0;

        slova.forEach((slovo, indexSlova) => {
          const obal = document.createElement("span");
          obal.className = "slovo-obal";

          if (poPismenech) {
            Array.from(slovo).forEach((znak) => {
              const kus = document.createElement("span");
              kus.className = "pismeno";
              kus.textContent = znak;
              kus.style.transitionDelay = `${poradi * 28}ms`;
              obal.appendChild(kus);
              poradi++;
            });
          } else {
            const kus = document.createElement("span");
            kus.className = "slovo";
            kus.textContent = slovo;
            kus.style.transitionDelay = `${poradi * 55}ms`;
            obal.appendChild(kus);
            poradi++;
          }

          prvek.appendChild(obal);
          if (indexSlova < slova.length - 1) {
            prvek.appendChild(document.createTextNode(" "));
          }
        });
      };

      // Znění nadpisů si opíšeme DŘÍV, než je rozsekáme. Rozsekaný nadpis
      // je pro čtečku obrazovky hromádka samostatných `inline-block` kousků
      // a některé ho pak hláskují po písmenech. `aria-label` na nadpisu jeho
      // obsah přebije, takže se přečte celá věta najednou. Vizuálně se tím
      // nemění nic.
      // Skládáme ho z jednotlivých řádek (nadpis v úvodu má dvě) a spojujeme
      // mezerou — `textContent` celého nadpisu by řádky slepil dohromady,
      // protože mezi nimi ve výsledném HTML žádný mezerový uzel není.
      const zneni = new Map<HTMLElement, string[]>();
      document
        .querySelectorAll<HTMLElement>("[data-pismena], [data-slova]")
        .forEach((kus) => {
          const nadpis = kus.closest<HTMLElement>("h1, h2, h3, h4, h5, h6");
          if (!nadpis) return;
          const casti = zneni.get(nadpis) ?? [];
          casti.push((kus.textContent ?? "").replace(/\s+/g, " ").trim());
          zneni.set(nadpis, casti);
        });

      document
        .querySelectorAll<HTMLElement>("[data-pismena]")
        .forEach((prvek) => rozsekej(prvek, true));

      document
        .querySelectorAll<HTMLElement>("[data-slova]")
        .forEach((prvek) => rozsekej(prvek, false));

      zneni.forEach((casti, nadpis) =>
        nadpis.setAttribute("aria-label", casti.join(" ")),
      );

      // Odhaluje se celý nadpis naráz, kaskádu si pohlídají prodlevy v CSS.
      const nadpisy = document.querySelectorAll<HTMLElement>(
        "[data-pismena], [data-slova]",
      );

      const pozorovatelNadpisu = new IntersectionObserver(
        (zaznamy) => {
          zaznamy.forEach((zaznam) => {
            if (!zaznam.isIntersecting) return;
            zaznam.target
              .querySelectorAll<HTMLElement>(".pismeno, .slovo")
              .forEach((kus) => kus.classList.add("je-videt"));
            pozorovatelNadpisu.unobserve(zaznam.target);
          });
        },
        { rootMargin: "0px 0px -60px 0px", threshold: 0.1 },
      );

      nadpisy.forEach((n) => pozorovatelNadpisu.observe(n));
    })();

    // ------------------------------------------------------------------
    // Odhalování obsahu, podtržení nadpisů, kreslené ilustrace, špendlíky
    // ------------------------------------------------------------------
    sleduj("[data-odhal]");
    sleduj(".podtrzeni");
    sleduj(".kresli-se");
    sleduj(".spendlik");
    sleduj(".vlna");

    // ------------------------------------------------------------------
    // Jedna smyčka pro všechno, co závisí na poloze scrollu
    // ------------------------------------------------------------------
    const priScrollu: Array<() => void> = [];
    let ceka = false;

    function prekresli() {
      if (ceka) return;
      ceka = true;
      requestAnimationFrame(() => {
        ceka = false;
        priScrollu.forEach((efekt) => efekt());
      });
    }

    // --- Pruh postupu čtení (celá stránka) ---------------------------
    (function pruhPostupu() {
      const pruh = document.querySelector<HTMLElement>("#pruh-postupu");
      if (!pruh) return;

      priScrollu.push(() => {
        const vyska = document.body.scrollHeight - window.innerHeight;
        const podil = vyska > 0 ? window.scrollY / vyska : 0;
        pruh.style.transform = `scaleX(${Math.min(Math.max(podil, 0), 1)})`;
      });
    })();

    // --- ÚVOD + ZÁSOBNÍK, ANIMACE 2 — paralaxa -----------------------
    // Vrstva se posouvá podle toho, jak daleko je od středu obrazovky.
    // Výchylka je omezená na 70 px: větší už by prvek utekl z kompozice
    // a na dlouhé stránce by se rozešel s textem, ke kterému patří.
    (function paralaxa() {
      const vrstvy = Array.from(
        document.querySelectorAll<HTMLElement>("[data-paralax]"),
      );
      if (vrstvy.length === 0) return;

      priScrollu.push(() => {
        const stredObrazovky = window.innerHeight / 2;

        vrstvy.forEach((vrstva) => {
          const r = vrstva.getBoundingClientRect();
          // Vrstvy mimo obrazovku přeskakujeme, ať se nepočítá zbytečně.
          if (r.bottom < -200 || r.top > window.innerHeight + 200) return;

          const rychlost = Number(vrstva.dataset.paralax ?? 0);
          const odchylka = r.top + r.height / 2 - stredObrazovky;
          const posun = Math.max(-70, Math.min(70, -odchylka * rychlost));
          vrstva.style.setProperty("--posun", `${posun.toFixed(1)}px`);
        });
      });
    })();

    // --- PROČ SE ZAPOJIT, ANIMACE 2 — přeliv plochy ------------------
    // Překryvná vrstva se prolne, jak sekce projíždí obrazovkou:
    // na krajích je průhledná, uprostřed plná.
    (function prelivPlochy() {
      const vrstva = document.querySelector<HTMLElement>("#preliv-proc");
      const sekce = document.querySelector<HTMLElement>("#proc-se-zapojit");
      if (!vrstva || !sekce) return;

      priScrollu.push(() => {
        const r = sekce.getBoundingClientRect();
        if (r.bottom < 0 || r.top > window.innerHeight) {
          vrstva.style.opacity = "0";
          return;
        }

        // 0 = sekce přichází zdola, 1 = odchází nahoru
        const prubeh =
          (window.innerHeight - r.top) / (window.innerHeight + r.height);
        const omezeny = Math.max(0, Math.min(1, prubeh));
        // Náběh a doběh: uprostřed plná, na krajích nic.
        const sila = 1 - Math.abs(omezeny * 2 - 1);
        vrstva.style.opacity = sila.toFixed(3);
      });
    })();

    // ------------------------------------------------------------------
    // JAK TO FUNGUJE, ANIMACE 1–3 — spojnice kreslená scrollem
    // ------------------------------------------------------------------
    // Čára vede středem koleček a roste shora dolů podle toho, kde jsi.
    // Kolečko, ke kterému došla, se rozsvítí; velké číslo v pozadí se
    // zvýrazní. Všechny kroky přitom zůstávají vidět.
    (function kresleniSpojnice() {
      const seznam = document.querySelector<HTMLElement>("#kroky-seznam");
      const dojeta = document.querySelector<HTMLElement>("#spojnice-dojeta");
      const kroky = Array.from(document.querySelectorAll<HTMLElement>(".krok"));
      const cisla = Array.from(
        document.querySelectorAll<HTMLElement>("[data-cislo-pozadi]"),
      );
      if (!seznam || !dojeta || kroky.length === 0) return;

      function prekresliSpojnici() {
        const r = seznam!.getBoundingClientRect();

        // Čára dojíždí k pomyslné rysce v dolní třetině obrazovky. Kdyby
        // byla u spodního okraje, čára by předbíhala to, co člověk čte.
        const ryska = window.innerHeight * 0.65;
        const podil = (ryska - r.top) / r.height;
        const dojeto = Math.max(0, Math.min(1, podil));
        dojeta!.style.setProperty("--dojeto", String(dojeto));

        // Kolečko se rozsvítí, jakmile ho čára minula.
        const rysovanaY = r.top + r.height * dojeto;
        let naRade = 0;

        kroky.forEach((krok, i) => {
          const k = krok.getBoundingClientRect();
          const stredKolecka = k.top + 28; // polovina výšky kolečka
          const dosazeno = stredKolecka <= rysovanaY + 4;

          krok.querySelector(".kolecko-kroku")?.classList.toggle(
            "dosazeno",
            dosazeno,
          );
          if (dosazeno) naRade = i;
        });

        kroky.forEach((krok, i) =>
          krok.classList.toggle("je-na-rade", i === naRade),
        );
        cisla.forEach((cislo, i) =>
          cislo.classList.toggle("je-na-rade", i === naRade),
        );
      }

      priScrollu.push(prekresliSpojnici);
    })();

    // Teprve teď, když jsou všechny efekty přihlášené, se smyčka pověsí na
    // scroll a jednou se spustí, aby stránka byla srovnaná hned po načtení.
    window.addEventListener("scroll", prekresli, { passive: true });
    window.addEventListener("resize", prekresli, { passive: true });
    prekresli();

    // ------------------------------------------------------------------
    // REGISTRACE, ANIMACE 1 a 3 — dopočítání částky a kruh za ní
    // ------------------------------------------------------------------
    // V HTML je rovnou cílové číslo, tady ho jen na chvíli srazíme na nulu
    // a necháme dopočítat. Trvá to necelou vteřinu, ať se na to nečeká.
    (function dopocitejCastku() {
      const cisla = document.querySelectorAll<HTMLElement>("[data-pocitadlo]");
      if (cisla.length === 0) return;

      const pozorovatelCisel = new IntersectionObserver(
        (zaznamy) => {
          zaznamy.forEach((zaznam) => {
            if (!zaznam.isIntersecting) return;
            const prvek = zaznam.target as HTMLElement;
            pozorovatelCisel.unobserve(prvek);

            // Ozdobný kruh za částkou se rozšíří spolu s dopočtem.
            prvek
              .closest("[data-odhal]")
              ?.querySelector(".kruh-za-castkou")
              ?.classList.add("je-videt");

            const cil = Number(prvek.dataset.pocitadlo ?? 0);
            const doba = 900;
            const zacatek = performance.now();

            const krok = (ted: number) => {
              const podil = Math.min((ted - zacatek) / doba, 1);
              // Zpomalení na konci, ať číslo „dosedne" a neuseknme ho.
              const zmirneny = 1 - Math.pow(1 - podil, 3);
              prvek.textContent = String(Math.round(cil * zmirneny));
              if (podil < 1) requestAnimationFrame(krok);
            };

            requestAnimationFrame(krok);
          });
        },
        { threshold: 0.5 },
      );

      cisla.forEach((c) => pozorovatelCisel.observe(c));
    })();

    // ------------------------------------------------------------------
    // Reakce na myš — jen tam, kde myš opravdu je
    // ------------------------------------------------------------------
    // Na dotykovém zařízení by se to nedalo vyvolat a jen by to ubíralo
    // výkon, tak to tam vůbec nespouštíme.
    if (!maMys) return;

    // --- ÚVOD, ANIMACE 3 — ilustrace se naklání za kurzorem ----------
    (function ilustraceZaMysi() {
      const prvky = Array.from(
        document.querySelectorAll<HTMLElement>("[data-mys]"),
      );
      if (prvky.length === 0) return;

      let cilX = 0;
      let cilY = 0;
      let x = 0;
      let y = 0;
      let bezi = false;

      window.addEventListener(
        "pointermove",
        (u) => {
          // −1 až 1 podle polohy kurzoru v okně.
          cilX = (u.clientX / window.innerWidth) * 2 - 1;
          cilY = (u.clientY / window.innerHeight) * 2 - 1;
          if (!bezi) {
            bezi = true;
            requestAnimationFrame(krok);
          }
        },
        { passive: true },
      );

      function krok() {
        // Kurzor doháníme se zpožděním, ať se ilustrace netrhá.
        x += (cilX - x) * 0.08;
        y += (cilY - y) * 0.08;

        prvky.forEach((prvek) => {
          const sila = Number(prvek.dataset.mys ?? 10);
          prvek.style.setProperty("--mys-x", `${(x * sila).toFixed(2)}px`);
          prvek.style.setProperty("--mys-y", `${(y * sila).toFixed(2)}px`);
          prvek.style.setProperty("--mys-uhel", `${(x * 1.5).toFixed(2)}deg`);
        });

        // Když se kurzor zastavil a dojeli jsme k němu, smyčku ukončíme.
        if (Math.abs(cilX - x) < 0.001 && Math.abs(cilY - y) < 0.001) {
          bezi = false;
          return;
        }
        requestAnimationFrame(krok);
      }
    })();

    // --- PROČ SE ZAPOJIT, ANIMACE 3 — náklon karty za kurzorem -------
    (function naklonKaret() {
      document.querySelectorAll<HTMLElement>(".naklon").forEach((karta) => {
        karta.addEventListener(
          "pointermove",
          (u) => {
            const r = karta.getBoundingClientRect();
            const px = (u.clientX - r.left) / r.width - 0.5;
            const py = (u.clientY - r.top) / r.height - 0.5;
            // Výchylka je schválně malá — přehnaný náklon působí lacině
            // a text na kartě se hůř čte.
            karta.style.transform = `perspective(900px) rotateX(${(-py * 5).toFixed(2)}deg) rotateY(${(px * 5).toFixed(2)}deg) translateY(-3px)`;
          },
          { passive: true },
        );

        karta.addEventListener("pointerleave", () => {
          karta.style.transform = "";
        });
      });
    })();

    // --- KE STAŽENÍ, ANIMACE 1 — magnetické tlačítko -----------------
    (function magnetickaTlacitka() {
      document.querySelectorAll<HTMLElement>(".magnet").forEach((tlacitko) => {
        tlacitko.addEventListener(
          "pointermove",
          (u) => {
            const r = tlacitko.getBoundingClientRect();
            const px = u.clientX - (r.left + r.width / 2);
            const py = u.clientY - (r.top + r.height / 2);
            // Nejvýš pár pixelů, ať se tlačítko dá pořád trefit.
            tlacitko.style.transform = `translate(${(px * 0.12).toFixed(1)}px, ${(py * 0.12).toFixed(1)}px)`;
          },
          { passive: true },
        );

        tlacitko.addEventListener("pointerleave", () => {
          tlacitko.style.transform = "";
        });
      });
    })();
  }
</script>
