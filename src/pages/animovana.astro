---
/**
 * ANIMOVANÁ VERZE — nabídka pohybu k proškrtání.
 *
 * Třetí verze k porovnání, ne náhrada. Uzemněná je na /, kreativní
 * na /kreativni/, tahle na /animovana/.
 *
 * ZADÁNÍ: každá sekce má nejméně dvě RŮZNÉ animace. Ne dvakrát totéž jinou
 * rychlostí — dvě odlišné myšlenky. U každé sekce je níž komentář, který
 * říká, které to jsou a co mají udělat. Podle něj se dá škrtat: každá
 * animace je samostatná, vyhození jedné nerozbije ostatní.
 *
 * OBSAH A POŘADÍ SEKCÍ jsou převzaté z kreativní verze. Rozdíl je jen
 * v jednom: kreativní verze nabízí dvě podoby sekce „Proč se zapojit"
 * vedle sebe (karty / jeden důvod na obrazovku), tady je jen jedna —
 * karty. Dvě varianty téhož by tu jen dvakrát ukazovaly stejné animace.
 *
 * TEXTY: doslova z podklady/texty.md a z kreativní verze. Nic přepsaného,
 * nic dopsaného.
 *
 * BARVY: schválená paleta beze změny. Červená je jen na tlačítkách.
 * Jediná výjimka, která na webu už je, je puntík u kategorie
 * „Pohyb a pobyt venku".
 *
 * VYPNUTÝ POHYB: `prefers-reduced-motion` vypíná úplně všechno. Skrývání
 * prvků visí na třídě `pohyb-ano`, kterou přidává krátký skript hned na
 * začátku stránky — a jen tehdy, když návštěvník pohyb nezakázal. Když ho
 * zakáže, nebo když nejede JavaScript, není nic průhledné ani posunuté
 * a stránka se chová jako obyčejný dokument. Podrobněji viz animovana.css.
 */
import Layout from "../layouts/Layout.astro";
import Ikona from "../components/Ikona.astro";
import Poradatele from "../components/Poradatele.astro";
import Tlacitko from "../components/Tlacitko.astro";
import FormularKrokovy from "../components/FormularKrokovy.astro";
import PrepinacVariant from "../components/PrepinacVariant.astro";
import Ilustrace from "../components/Ilustrace.astro";
import Mapa from "../components/Mapa.astro";
import "../styles/animovana.css";
import { EMAIL, TELEFON_ODKAZ, TELEFON_ZOBRAZIT } from "../lib/kontakt";

// --- Data sekcí (převzatá z kreativní verze beze změny) -------------------

// Tipy na aktivity rozdělené do tří kategorií přesně podle podkladů.
// Každá kategorie má vlastní barvu puntíku, ať jdou od sebe rozeznat
// i letmým pohledem.
const kategorieTipu = [
  {
    nazev: "Kultura a tvořivost",
    barva: "var(--color-merunka)",
    polozky: [
      "Společný zpěv",
      "Výtvarná dílna",
      "Tvoření dekorací",
      "Společné čtení",
    ],
  },
  {
    nazev: "Pohyb a pobyt venku",
    barva: "var(--color-tlacitko)",
    polozky: ["Nenáročná procházka", "Zahradní hry", "Mölkky", "Pétanque"],
  },
  {
    nazev: "Sdílení a setkávání",
    barva: "var(--color-potvrzeni)",
    polozky: ["Hraní stolních her", "Vyprávění příběhů", "Vzájemné učení"],
  },
];

// Aktivity na střídačku, ne po kategoriích za sebou — jinak by na řádce
// byly čtyři meruňkové, pak čtyři červené a pak tři zelené a vypadalo by to
// jako tři slepené seznamy.
const tipyNaStridacku = (() => {
  const vysledek: { nazev: string; barva: string }[] = [];
  const nejdelsi = Math.max(...kategorieTipu.map((k) => k.polozky.length));

  for (let i = 0; i < nejdelsi; i++) {
    for (const kategorie of kategorieTipu) {
      const polozka = kategorie.polozky[i];
      if (polozka) vysledek.push({ nazev: polozka, barva: kategorie.barva });
    }
  }
  return vysledek;
})();

const skupiny = [
  { popis: "Školy a školky", ikona: "school" },
  { popis: "Mladé kolektivy a firmy", ikona: "building-2" },
  { popis: "Neziskovky a komunity", ikona: "heart-handshake" },
  { popis: "Gen Z a nadšenci", ikona: "sparkles" },
];

const duvody = [
  {
    ikona: "sparkles",
    nadpis: "Smysluplný zážitek a lidské spojení",
    text: "Oslavíte Mezinárodní den seniorů tvořivou, lidskou a citlivou formou. Vyzkoušíte si, jak snadné a obohacující je bořit bariéry a hledat to, co různé generace spojuje.",
  },
  {
    ikona: "heart-handshake",
    nadpis: "Hodnoty, které dávají smysl",
    text: "Ať už zapojíte školní třídu, firemní tým nebo partu přátel, připomenete si význam mezigenerační solidarity a pomůžete rozvíjet přirozený respekt, empatii a úctu ke starším generacím.",
  },
  {
    ikona: "users",
    nadpis: "Zkušenost, která utuží tým",
    text: "Společná příprava a realizace akce je skvělý teambuilding. Spojíte lidi pro dobrou věc — ať už jde o žáky ve třídě, kolegy v práci, členy spolku nebo přátele.",
  },
  {
    ikona: "lightbulb",
    nadpis: "Inspirace pro celou ČR",
    text: "Vaše společné setkání nezůstane zapomenuto. Stane se inspirativní součástí celostátního Zásobníku mezigeneračních aktivit, kde usnadníte ostatním vymýšlet podobné mezigenerační akce.",
  },
  {
    ikona: "award",
    nadpis: "Certifikát a odměna",
    text: "Každý zapojený jednotlivec, tým či skupina získá účastnický certifikát a bude zařazen/a do losování o poukazy na společnou večeři, sportovní nebo výtvarné pomůcky!",
  },
];

const kroky = [
  {
    nadpis: "Najděte seniorské partnerské místo v okolí",
    text: "Propojte se s místním klubem seniorů, domovem pro seniory nebo aktivními seniory ve vaší obci.",
  },
  {
    nadpis: "Domluvte vhodnou a bezpečnou aktivitu",
    text: "Zvolte program, který bude příjemný a zvládnutelný pro obě strany.",
  },
  {
    nadpis: "Zaregistrujte se na webu",
    text: "Vyplňte krátký přihlašovací formulář a uhradíte symbolický registrační poplatek.",
  },
  {
    nadpis: "Prožijte setkání a sdílejte radost",
    text: "V týdnu kolem 1. 10. proběhnou vaše akce. Následně, budete-li mít chuť se podělit, vyplníte do aplikace Zásobník nápadů krátký popis a fotky z vaší akce.",
  },
];

// Ukázka záznamů v Zásobníku. Názvy aktivit jsou z podkladů (Tipy na
// aktivity), údaje na kartách odpovídají tomu, na co se po akci ptá formulář.
const ukazkaZasobniku = [
  {
    nazev: "Výtvarná dílna",
    kategorie: "Kultura a tvořivost",
    barva: "var(--color-merunka)",
    narocnost: "Nenáročné",
    pomucky: "Papír, pastelky, nůžky",
  },
  {
    nazev: "Zahradní hry",
    kategorie: "Pohyb a pobyt venku",
    barva: "var(--color-tlacitko)",
    narocnost: "Střední",
    pomucky: "Mölkky, pétanque",
  },
  {
    nazev: "Vyprávění příběhů",
    kategorie: "Sdílení a setkávání",
    barva: "var(--color-potvrzeni)",
    narocnost: "Nenáročné",
    pomucky: "Židle, klidný prostor",
  },
];

const podpora = [
  {
    ikona: "message-circle",
    nadpis: "Konzultace programu",
    text: "Nejste si jistí vhodností aktivity? Rádi s vámi nápad zkonzultujeme.",
    smer: "zleva",
  },
  {
    ikona: "map-pin",
    nadpis: "Pomoc s nasměrováním",
    text: "Pokud váháte, koho v okolí oslovit, pokusíme se vás propojit se seniorskými organizacemi.",
    smer: "zdola",
  },
  {
    ikona: "award",
    nadpis: "Certifikát a zařazení do losování",
    text: "Ocenění pro žáky a možnost získat věcné odměny pro vaši třídu či skupinu.",
    smer: "zprava",
  },
];
---

<Layout
  titulek="Mezigeneračně aktivně spolu — animovaná verze"
  popis="Zorganizujte mezigenerační setkání se seniory v týdnu kolem 1. října a staňte se součástí celostátního Zásobníku nápadů."
  sMenu={true}
>
  {/* POZOR — tenhle skript musí zůstat úplně první.
      Zapíná pohyb tím, že na <html> pověsí třídu `pohyb-ano`. Teprve na ní
      visí všechna pravidla, která něco schovávají. Když ho návštěvník
      nechce (nebo když JavaScript nejede), třída se nepřidá a stránka je
      od první chvíle celá vidět.
      Je vepsaný přímo do HTML (`is:inline`), aby se stihl vykonat dřív, než
      prohlížeč vykreslí obsah pod ním — jinak by obsah na okamžik probliknul
      a teprve pak zmizel. */}
  <script is:inline>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("pohyb-ano");
    }
  </script>

  <PrepinacVariant aktivni="animovana" />

  {/* Ukazatel průběhu čtení — orientace na dlouhé stránce. */}
  <div class="pruh-postupu" id="pruh-postupu" aria-hidden="true"></div>

  {/* ======================================================================
      ÚVOD
      ----------------------------------------------------------------------
      ANIMACE 1 — Nadpis se skládá. První řádka po písmenech, druhá po
                  slovech. Má dát očím rytmus a zdržet je na hlavním sdělení.
      ANIMACE 2 — Paralaxa. Ozdobná skvrna, ilustrace a text jedou při
                  scrollu různou rychlostí, takže úvod má hloubku a nepůsobí
                  jako plochý obrázek.
      ANIMACE 3 — Ilustrace se naklání za polohou myši. Jen na zařízeních
                  s myší; na dotyku by to nešlo vyvolat a nic se neděje.
      TEXTEM SE NEHÝBE — paralaxa se týká jen ozdob a ilustrace.
      ====================================================================== */}
  <section
    id="uvod"
    class="relative overflow-hidden px-5 pt-8 pb-20"
    style="background: linear-gradient(180deg, var(--color-plocha-tyrkys) 0%, var(--color-pozadi) 100%)"
  >
    {/* Ozdobné tvary v pozadí. Jedou pomaleji než obsah (ANIMACE 2). */}
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="vrstva-paralaxy absolute -top-40 -right-32 h-[600px] w-[600px] rounded-full opacity-40 blur-3xl"
        data-paralax="0.18"
        style="background: var(--color-merunka-tlumena)"
      >
      </div>
      <div
        class="vrstva-paralaxy absolute -bottom-52 -left-40 h-[440px] w-[440px] rounded-full opacity-30 blur-3xl"
        data-paralax="-0.12"
        style="background: var(--color-plocha-tyrkys)"
      >
      </div>
    </div>

    {/* `grid-cols-1` (tedy `minmax(0, 1fr)`) je tu schválně: bez něj by
        automatický sloupec převzal pevnou šířku ilustrace (340 px) a na
        úzkém telefonu by se nadpis i odstavec roztáhly mimo obrazovku. */}
    <div
      class="relative z-10 mx-auto grid max-w-obsah grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center"
    >
      <div>
        <h1 class="text-[clamp(2.5rem,6vw,4.75rem)] leading-[1.05] tracking-tight">
          <span class="block" data-pismena>Propojme generace.</span>
          <span class="block text-text" data-slova>
            Vytvořte setkání, na které se nezapomíná.
          </span>
        </h1>

        <p
          class="mt-8 max-w-[680px] text-xl sm:text-2xl"
          data-odhal="zdola"
          style="--prodleva: 260ms"
        >
          Ať už vedete školu, tvoříte mladý pracovní kolektiv, působíte
          v neziskovce nebo chcete s přáteli udělat něco smysluplného — oslavte
          s námi Mezinárodní den seniorů (v týdnu kolem 1.&nbsp;10.).
        </p>
      </div>

      {/* Ilustrace: paralaxa (ANIMACE 2) na obalu, sledování myši
          (ANIMACE 3) na vnitřku, kreslení tahem při příchodu na vlastním SVG. */}
      <div
        class="vrstva-paralaxy justify-self-center lg:justify-self-end"
        data-paralax="-0.16"
      >
        <div class="sleduje-mys text-tyrkys" data-mys="10">
          {/* `max-w-full` — na obrazovce užší než 340 px se ilustrace zmenší,
              místo aby přečnívala. */}
          <Ilustrace
            jmeno="senior-s-kytici"
            sirka={340}
            kresliSe
            trida="h-auto max-w-full"
          />
        </div>
      </div>
    </div>

    <div class="relative z-10 mx-auto max-w-obsah">
      {/* Pro koho to je — prostý výpis, na který se neklikají. */}
      <ul class="mt-10 flex list-none flex-wrap gap-x-8 gap-y-3 p-0">
        {
          skupiny.map((skupina, i) => (
            <li
              class="flex items-center gap-2"
              data-odhal="zdola"
              style={`--prodleva: ${360 + i * 70}ms`}
            >
              <Ikona jmeno={skupina.ikona} velikost={22} />
              <span>{skupina.popis}</span>
            </li>
          ))
        }
      </ul>

      <div
        class="mt-8 flex flex-wrap gap-4"
        data-odhal="zdola"
        style="--prodleva: 660ms"
      >
        <Tlacitko odkaz="#registrace" trida="magnet text-lg">
          Chci se zapojit
          <Ikona jmeno="arrow-right" velikost={22} trida="text-white" />
        </Tlacitko>

        {/* [DOPLNIT: informační leták v PDF] */}
        <Tlacitko odkaz="#ke-stazeni" varianta="vedlejsi" trida="magnet">
          <Ikona jmeno="download" velikost={20} trida="ikona-stazeni" />
          Stáhnout leták
        </Tlacitko>
      </div>
    </div>
  </section>

  {/* ======================================================================
      PROČ SE ZAPOJIT
      ----------------------------------------------------------------------
      ANIMACE 1 — Karty naskakují v kaskádě, každá o 80 ms později. Oko jde
                  po nich popořadě místo toho, aby na něj spadlo šest karet
                  naráz.
      ANIMACE 2 — Plocha sekce se během průjezdu přelije z krémové do
                  tyrkysové a zase zpět. Neplete se barva pozadí (to by
                  prohlížeč překresloval), prolíná se překryvná vrstva.
      ANIMACE 3 — Karta se naklání za kurzorem, aby bylo poznat, na které
                  člověk zrovna je.
      ====================================================================== */}
  <section id="proc-se-zapojit" class="relative overflow-hidden bg-pozadi px-5 py-16">
    <div class="prelivova-plocha" id="preliv-proc" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto max-w-obsah">
      <h2 class="text-[clamp(1.75rem,3.5vw,2.75rem)]" data-slova>
        Proč se do projektu zapojit, proč do toho jít?
      </h2>
      <span class="podtrzeni"></span>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          duvody.map((duvod, i) => (
            <div data-odhal="zdola" style={`--prodleva: ${i * 80}ms`}>
              <article class="naklon h-full rounded-2xl border border-merunka-tlumena bg-white p-7">
                <Ikona jmeno={duvod.ikona} velikost={36} />
                <h3 class="mt-4 text-xl">{duvod.nadpis}</h3>
                <p class="mt-3 mb-0">{duvod.text}</p>
              </article>
            </div>
          ))
        }

        <div data-odhal="zdola" style={`--prodleva: ${duvody.length * 80}ms`}>
          <article
            class="naklon flex h-full flex-col justify-center rounded-2xl p-7 text-white"
            style="background: linear-gradient(135deg, var(--color-tyrkys), #0d5560)"
          >
            <Ikona jmeno="target" velikost={36} trida="text-white" />
            <h3 class="mt-4 text-xl text-white">Cíl akce</h3>
            <p class="mt-3 mb-0">
              Podpora mezigenerační solidarity, vytváření přirozených vazeb mezi
              nejmladší a nejstarší generací a oslava Mezinárodního dne seniorů
              v duchu vzájemného respektu, lidskosti a radosti ze společně
              stráveného času.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  {/* ======================================================================
      JAK TO FUNGUJE
      ----------------------------------------------------------------------
      ANIMACE 1 — Spojnice se kreslí shora dolů podle toho, jak daleko jsi
                  sekcí projel. Vede přímo skrz kolečka kroků a když se
                  vrátíš nahoru, vrátí se s tebou.
      ANIMACE 2 — Kolečko kroku, ke kterému čára došla, se rozsvítí a zvětší.
      ANIMACE 3 — Velká čísla v pozadí se s krokem prostřídají.

      Přišpendlení sem nepatří: zadavatel chce vidět všechny čtyři kroky
      naráz, aby bylo hned poznat, že jsou jen čtyři a jsou zvládnutelné.
      Postup se ukazuje čárou, ne přepínáním obsahu.
      ====================================================================== */}
  <section id="jak-to-funguje" class="relative overflow-hidden bg-plocha-tyrkys px-5 py-20">
    {/* Velká čísla v pozadí. Jsou ozdoba, ne informace — pořadí kroku je
        v kolečku vedle textu, tak je čtečka obrazovky přeskočí. */}
    <div
      class="cisla-v-pozadi pointer-events-none absolute top-0 right-0 hidden h-full flex-col justify-around pr-6 lg:flex"
      aria-hidden="true"
    >
      {
        kroky.map((_, i) => (
          <span class="cislo-pozadi" data-cislo-pozadi={i + 1}>
            {i + 1}
          </span>
        ))
      }
    </div>

    <div class="relative mx-auto max-w-obsah">
      <h2 class="text-[clamp(1.75rem,3.5vw,2.75rem)]" data-slova>
        4 jednoduché kroky k realizaci
      </h2>
      <span class="podtrzeni"></span>

      <ol id="kroky-seznam" class="relative m-0 mt-14 list-none p-0">
        {/* Spojnice vede středem koleček. Šedá je celá dráha, meruňková
            část ukazuje, kam jsi došel. */}
        <span class="spojnice-drazka" aria-hidden="true"></span>
        <span class="spojnice-dojeta" id="spojnice-dojeta" aria-hidden="true"></span>

        {
          kroky.map((krok, i) => (
            <li
              class="krok relative flex items-start gap-6 sm:gap-10"
              data-poradi-kroku={i + 1}
            >
              <span
                class="kolecko-kroku relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-full text-2xl font-semibold"
                aria-hidden="true"
              >
                {i + 1}
              </span>

              <div class="min-w-0 flex-1 pt-2">
                <h3 class="text-2xl sm:text-3xl">{krok.nadpis}</h3>
                <p class="mt-3 mb-0 max-w-[600px] text-lg">{krok.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ======================================================================
      TIPY NA AKTIVITY
      ----------------------------------------------------------------------
      ANIMACE 1 — Řádka s nápady jede plynule do strany. Po najetí myší
                  (a při focusu z klávesnice) se zastaví, aby se dala číst.
      ANIMACE 2 — Položky legendy naskakují po sobě zleva, takže je vidět,
                  že jde o tři samostatné okruhy, ne o jeden seznam.
      ANIMACE 3 — Ozdobná skvrna v pozadí pomalu dýchá. Dlouhý cyklus, malá
                  výchylka — jen aby sekce nepůsobila zamrzle.
      ====================================================================== */}
  <section id="tipy-na-aktivity" class="relative overflow-hidden bg-pozadi py-16">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="dycha absolute top-10 -left-24 h-[380px] w-[380px] rounded-full opacity-45 blur-3xl"
        style="background: var(--color-plocha-tyrkys)"
      >
      </div>
    </div>

    <div class="relative z-10 mx-auto max-w-obsah px-5">
      <h2 class="text-[clamp(1.75rem,3.5vw,2.75rem)]" data-slova>
        Čím se můžete inspirovat?
      </h2>
      <span class="podtrzeni"></span>

      {/* Legenda — barva puntíku je kategorie, ne ozdoba (ANIMACE 2). */}
      <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-2 p-0">
        {
          kategorieTipu.map((kategorie, i) => (
            <li
              class="flex items-center gap-2.5"
              data-odhal="zleva"
              style={`--prodleva: ${i * 110}ms`}
            >
              <span
                class="h-3 w-3 shrink-0 rounded-full"
                style={`background-color: ${kategorie.barva}`}
              />
              <span class="text-popisek font-semibold">{kategorie.nazev}</span>
            </li>
          ))
        }
      </ul>
    </div>

    {/* Jedoucí řádka (ANIMACE 1).
