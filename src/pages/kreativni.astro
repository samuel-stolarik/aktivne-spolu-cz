  {/* ================= PODPORA ================= */}
  <section id="podpora" class="bg-pozadi px-5 py-16">
    <div class="mx-auto max-w-obsah">
      <h2 class="text-[clamp(1.75rem,3.5vw,2.75rem)]" data-rozlozit>
