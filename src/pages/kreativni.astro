---
/**
 * KREATIVNÍ VERZE — nabídka k proškrtání.
 *
 * Záměrně přestimulovaná. Je to katalog nápadů, ne finální podoba:
 * vyberte, co dává smysl, zbytek se vyhodí. Každý efekt je samostatný,
 * takže vyhození jednoho nerozbije ostatní.
 *
 * Oproti uzemněné verzi na / se liší ve třech věcech:
 *   1. Stránka je postavená kolem CÍLOVÝCH SKUPIN — návštěvník si vybere,
 *      kdo je, a obsah se podle toho zvýrazní.
 *   2. Pohyb reaguje na scroll i na myš, ne jen na příchod do obrazovky.
 *   3. Typografie a plochy jsou výrazně větší.
 *
 * TEXTY: všechny převzaté doslova z podklady/texty.md. Kde bylo potřeba
 * spojovací věty, které v podkladech nejsou, jsou označené jako
 * [NÁVRH TEXTU: …] — ty musí schválit zadavatel, nebo se nahradí jinými.
 *
 * BARVY: schválená paleta beze změny. Kreativita je v pohybu, měřítku
 * a kompozici — paleta je značka, tu si vymýšlet nebudu. Červená zůstává
 * vyhrazená tlačítkům.
 */
import Layout from "../layouts/Layout.astro";
import Ikona from "../components/Ikona.astro";
import Tlacitko from "../components/Tlacitko.astro";
import FormularKrokovy from "../components/FormularKrokovy.astro";
import PrepinacVariant from "../components/PrepinacVariant.astro";
import Stitek from "../components/Stitek.astro";
import Poradatele from "../components/Poradatele.astro";
import Ilustrace from "../components/Ilustrace.astro";
import Mapa from "../components/Mapa.astro";
import "../styles/kreativni.css";
import { EMAIL, OSOBA, TELEFON_ODKAZ, TELEFON_ZOBRAZIT } from "../lib/kontakt";

// Tipy na aktivity rozdělené do tří kategorií přesně podle podkladů.
// Každá kategorie má vlastní barvu puntíku, ať jdou od sebe rozeznat
// i letmým pohledem.
const kategorieTipu = [
  {
    nazev: "Kultura a tvořivost",
    ikona: "palette",
    barva: "var(--color-merunka)",
    polozky: [
      "Společný zpěv",
      "Výtvarná dílna",
      "Tvoření dekorací",
      "Společné čtení",
    ],
  },
  {
    nazev: "Pohyb a pobyt venku",
    ikona: "footprints",
    barva: "var(--color-tlacitko)",
    polozky: [
      "Nenáročná procházka",
      "Zahradní hry",
      "Mölkky",
      "Pétanque",
    ],
  },
  {
    nazev: "Sdílení a setkávání",
    ikona: "message-circle",
    barva: "var(--color-potvrzeni)",
    polozky: [
      "Hraní stolních her",
      "Vyprávění příběhů",
      "Vzájemné učení",
    ],
  },
];

// Aktivity na střídačku, ne po kategoriích za sebou.
// Kdyby šly popořadě, byly by na řádce čtyři meruňkové, pak čtyři červené
// a pak tři zelené — vypadalo by to jako tři slepené seznamy. Takhle se
// barvy střídají, ale puntík pořád drží svoji kategorii.
const tipyNaStridacku = (() => {
  const vysledek: { nazev: string; barva: string }[] = [];
  const nejdelsi = Math.max(...kategorieTipu.map((k) => k.polozky.length));

  for (let i = 0; i < nejdelsi; i++) {
    for (const kategorie of kategorieTipu) {
      const polozka = kategorie.polozky[i];
      if (polozka) vysledek.push({ nazev: polozka, barva: kategorie.barva });
    }
  }
  return vysledek;
})();

// Cílové skupiny přesně podle podkladů (hero, doplňkový vizuální prvek).
const skupiny = [
  {
    klic: "skoly",
    popis: "Školy a školky",
    ikona: "school",
  },
  {
    klic: "firmy",
    popis: "Mladé kolektivy a firmy",
    ikona: "building-2",
  },
  {
    klic: "neziskovky",
    popis: "Neziskovky a komunity",
    ikona: "heart-handshake",
  },
  {
    klic: "genz",
    popis: "Gen Z a nadšenci",
    ikona: "sparkles",
  },
];

// Důvody z podkladů, doplněné o to, koho oslovují nejvíc.
// Text je doslovný, přiřazení ke skupinám je navíc kvůli filtrování.
const duvody = [
  {
    ikona: "sparkles",
    nadpis: "Smysluplný zážitek a lidské spojení",
    text: "Oslavíte Mezinárodní den seniorů tvořivou, lidskou a citlivou formou. Vyzkoušíte si, jak snadné a obohacující je bořit bariéry a hledat to, co různé generace spojuje.",
    pro: ["skoly", "firmy", "neziskovky", "genz"],
  },
  {
    ikona: "heart-handshake",
    nadpis: "Hodnoty, které dávají smysl",
    text: "Ať už zapojíte školní třídu, firemní tým nebo partu přátel, připomenete si význam mezigenerační solidarity a pomůžete rozvíjet přirozený respekt, empatii a úctu ke starším generacím.",
    pro: ["skoly", "neziskovky"],
  },
  {
    ikona: "users",
    nadpis: "Zkušenost, která utuží tým",
    text: "Společná příprava a realizace akce je skvělý teambuilding. Spojíte lidi pro dobrou věc — ať už jde o žáky ve třídě, kolegy v práci, členy spolku nebo přátele.",
    pro: ["firmy", "neziskovky", "genz"],
  },
  {
    ikona: "lightbulb",
    nadpis: "Inspirace pro celou ČR",
    text: "Vaše společné setkání nezůstane zapomenuto. Stane se inspirativní součástí celostátního Zásobníku mezigeneračních aktivit, kde usnadníte ostatním vymýšlet podobné mezigenerační akce.",
    pro: ["skoly", "firmy", "neziskovky", "genz"],
  },
  {
    ikona: "award",
    nadpis: "Certifikát a odměna",
    text: "Každý zapojený jednotlivec, tým či skupina získá účastnický certifikát a bude zařazen/a do losování o poukazy na společnou večeři, sportovní nebo výtvarné pomůcky!",
    pro: ["skoly", "genz"],
  },
];

const kroky = [
  {
    nadpis: "Najděte seniorské partnerské místo v okolí",
    text: "Propojte se s místním klubem seniorů, domovem pro seniory nebo aktivními seniory ve vaší obci.",
  },
  {
    nadpis: "Domluvte vhodnou a bezpečnou aktivitu",
    text: "Zvolte program, který bude příjemný a zvládnutelný pro obě strany.",
  },
  {
    nadpis: "Zaregistrujte se na webu",
    text: "Vyplňte krátký přihlašovací formulář a uhradíte symbolický registrační poplatek.",
  },
  {
    nadpis: "Prožijte setkání a sdílejte radost",
    text: "V týdnu kolem 1. 10. proběhnou vaše akce. Následně, budete-li mít chuť se podělit, vyplníte do aplikace Zásobník nápadů krátký popis a fotky z vaší akce.",
  },
];


const nadpisHero = "Propojme generace.";
const nadpisHero2 = "Vytvořte setkání, na které se nezapomíná.";
---

<Layout
  titulek="Mezigeneračně aktivně spolu — kreativní verze"
  popis="Zorganizujte mezigenerační setkání se seniory v týdnu kolem 1. října a staňte se součástí celostátního Zásobníku nápadů."
  sMenu={true}
>
  <PrepinacVariant aktivni="kreativni" />

  <div class="pruh-postupu" id="pruh-postupu" aria-hidden="true"></div>
  <div class="svetlo-mysi" id="svetlo-mysi" aria-hidden="true"></div>

  {/* ================= HERO ================= */}
  <section
    id="uvod"
    class="relative overflow-hidden px-5 pt-8 pb-20"
    style="background: linear-gradient(180deg, var(--color-plocha-tyrkys) 0%, var(--color-pozadi) 100%)"
  >
    {/* Logo tu schválně není — je v horní liště a dvakrát na jedné
        obrazovce nemá co dělat. */}
    <div
      class="relative z-10 mx-auto grid max-w-obsah gap-10 lg:grid-cols-[1fr_auto] lg:items-center"
    >
      <div>
        <h1
          class="text-[clamp(2.5rem,6vw,4.75rem)] leading-[1.05] tracking-tight"
          data-rozlozit
        >
          {nadpisHero}
          <span class="block text-text">{nadpisHero2}</span>
        </h1>

        <p class="mt-8 max-w-[680px] text-xl sm:text-2xl">
          Ať už vedete školu, tvoříte mladý pracovní kolektiv, působíte
          v neziskovce nebo chcete s přáteli udělat něco smysluplného — oslavte
          s námi Mezinárodní den seniorů (v týdnu kolem 1.&nbsp;10.).
        </p>
      </div>

      {/* DVĚ VARIANTY ÚVODNÍ ILUSTRACE K HLASOVÁNÍ.
          Zobrazuje se vždycky jen jedna, přepínač je pod ní. Až padne
          rozhodnutí, nechá se vybraná a přepínač i druhá varianta se smažou. */}
      <div class="justify-self-center lg:justify-self-end">
        <div class="pohupuje-se text-tyrkys">
          <div data-hero-ilustrace="kytice">
            <Ilustrace jmeno="senior-s-kytici" sirka={340} kresliSe />
          </div>
          <div data-hero-ilustrace="generace" hidden>
            <Ilustrace jmeno="mezigeneracne" sirka={340} kresliSe />
          </div>
        </div>

        <div
          id="prepinac-hero"
          class="mt-4 flex items-center justify-center gap-1 rounded-full border border-merunka-tlumena bg-white/80 p-1"
        >
          <span class="px-3 text-popisek font-semibold text-tyrkys">
            Úvodní obrázek:
          </span>
          <button
            type="button"
            data-volba-hero="kytice"
            aria-pressed="true"
            class="volba-hero min-h-11 cursor-pointer rounded-full px-4 text-popisek"
          >
            A — s kyticí
          </button>
          <button
            type="button"
            data-volba-hero="generace"
            aria-pressed="false"
            class="volba-hero min-h-11 cursor-pointer rounded-full px-4 text-popisek"
          >
            B — dvě generace
          </button>
        </div>
      </div>
    </div>

    <div class="relative z-10 mx-auto max-w-obsah">

      {/* ---- Pro koho to je ----
          Jen výpis, na který se neklikají. Dřív to byl přepínač, který níž
          na stránce ztlumil důvody netýkající se vybrané skupiny — zadavatel
          si vyžádal prostý výpis bez rámečků a bez prokliku, takže filtrování
          zaniklo. Kdyby se k němu někdy vracelo, je v historii gitu. */}
      <ul class="mt-10 flex list-none flex-wrap gap-x-8 gap-y-3 p-0">
        {
          skupiny.map((skupina) => (
            <li class="flex items-center gap-2">
              <Ikona jmeno={skupina.ikona} velikost={22} />
              <span>{skupina.popis}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap gap-4">
        <Tlacitko odkaz="#registrace" trida="magnet text-lg">
          Chci se zapojit
          <Ikona jmeno="arrow-right" velikost={22} trida="text-white" />
        </Tlacitko>

        {/* [DOPLNIT: informační leták v PDF] */}
        <Tlacitko odkaz="#ke-stazeni" varianta="vedlejsi" trida="magnet">
          <Ikona jmeno="download" velikost={20} />
          Stáhnout leták
        </Tlacitko>
      </div>


    </div>

    {/* Velké měkké tvary v pozadí */}
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute -top-40 -right-32 h-[600px] w-[600px] rounded-full opacity-40 blur-3xl"
        style="background: var(--color-merunka-tlumena)"
      >
      </div>
    </div>
  </section>

  {/* ============ PROČ SE ZAPOJIT — VARIANTA 1: karty ============ */}
  {/* Podoba z úvodního návrhu: všechny důvody vedle sebe jako karty.
      Textu je na obrazovce nejvíc ze všech variant, zato je vidět všechno
      naráz a nic se neschovává za klikání. */}
  <section id="proc-se-zapojit" class="bg-pozadi px-5 py-16">
    <div class="mx-auto max-w-obsah">
      <Stitek>Varianta 1 — karty vedle sebe</Stitek>

      <h2 class="mt-4 text-[clamp(1.75rem,3.5vw,2.75rem)]" data-rozlozit>
        Proč se do projektu zapojit, proč do toho jít?
      </h2>
      <span class="podtrzeni"></span>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          duvody.map((duvod) => (
            <article
              class="naklon rounded-2xl border border-merunka-tlumena bg-white p-7"
            >
              <Ikona jmeno={duvod.ikona} velikost={36} />
              <h3 class="mt-4 text-xl">{duvod.nadpis}</h3>
              <p class="mt-3 mb-0">{duvod.text}</p>
            </article>
          ))
        }

        <article
          class="flex flex-col justify-center rounded-2xl p-7 text-white"
          style="background: linear-gradient(135deg, var(--color-tyrkys), #0d5560)"
        >
          <Ikona jmeno="target" velikost={36} trida="text-white" />
          <h3 class="mt-4 text-xl text-white">Cíl akce</h3>
          <p class="mt-3 mb-0">
            Podpora mezigenerační solidarity, vytváření přirozených vazeb mezi
            nejmladší a nejstarší generací a oslava Mezinárodního dne seniorů
            v duchu vzájemného respektu, lidskosti a radosti ze společně
            stráveného času.
          </p>
        </article>
      </div>
    </div>
  </section>

  {/* ================= PROČ SE ZAPOJIT — VARIANTA E ================= */}
  {/* E: jeden důvod přes celou obrazovku. Nadpis zůstává přilepený vlevo
      a důvody se pod ním střídají, jak scrolluješ. Textu je na obrazovce
      vždycky jen jeden odstavec, ale nic se neschovává za klikání. */}
  <section id="proc-se-zapojit-e" class="bg-plocha-tyrkys px-5 py-16">
    <div class="mx-auto max-w-obsah">
      <Stitek>Varianta 2 — jeden důvod na obrazovku</Stitek>

      <div class="mt-4 grid gap-10 lg:grid-cols-[320px_1fr] lg:items-start">
        <div class="lg:sticky lg:top-24">
          <h2 class="text-[clamp(1.75rem,3.5vw,2.75rem)]" data-rozlozit>
            Proč do toho jít?
          </h2>
          <span class="podtrzeni"></span>

          {/* Počítadlo ukazuje, kolikátý důvod je právě na obrazovce. */}
          <p class="mt-6 text-popisek" id="pocitadlo-duvodu">
            1 z {duvody.length}
          </p>
        </div>

        <div id="duvody-e" class="space-y-6">
          {
            duvody.map((duvod, i) => (
              <article
                class="duvod-e rounded-2xl bg-white p-8 sm:p-10"
                data-poradi-duvodu={i + 1}
              >
                <Ikona jmeno={duvod.ikona} velikost={44} />
                <h3 class="mt-5 text-2xl sm:text-3xl">{duvod.nadpis}</h3>
                <p class="mt-4 mb-0 text-lg">{duvod.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ================= JAK TO FUNGUJE — kreslená cesta ================= */}
  <section id="jak-to-funguje" class="relative bg-plocha-tyrkys px-5 py-20">
    <div class="mx-auto max-w-obsah">
      <div class="flex items-end justify-between gap-8">
        <div>
          <h2 class="text-[clamp(1.75rem,3.5vw,2.75rem)]" data-rozlozit>
            4 jednoduché kroky k realizaci
          </h2>
          <span class="podtrzeni"></span>
        </div>

        <div class="hidden shrink-0 text-tyrkys md:block">
          <Ilustrace jmeno="mezigeneracne" sirka={190} kresliSe />
        </div>
      </div>

      <div id="cesta-obal" class="relative mt-16">
        {/* Čára se kreslí podle toho, jak daleko jste odscrollovaní. */}
        <svg
          class="pointer-events-none absolute top-0 left-5 h-full w-16 sm:left-8"
          aria-hidden="true"
          preserveAspectRatio="none"
          viewBox="0 0 64 1000"
        >
          <path
            id="cesta"
            class="cesta"
            d="M32 0 C 8 200, 56 300, 32 500 S 8 800, 32 1000"
            fill="none"
            stroke="var(--color-merunka)"
            stroke-width="4"
            stroke-linecap="round"
          ></path>
        </svg>

        <ol class="relative m-0 list-none space-y-20 p-0">
          {
            kroky.map((krok, i) => (
              <li class="relative flex items-start gap-6 pl-2 sm:gap-10 sm:pl-6">
                <span
                  class="z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-merunka text-2xl font-semibold text-text shadow-lg"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>

                <div class="relative min-w-0 flex-1">
                  <span
                    class="cislo-v-pozadi pointer-events-none absolute -top-10 right-0 -z-10"
                    aria-hidden="true"
                  >
                    {i + 1}
                  </span>
                  <h3 class="text-2xl sm:text-3xl" data-rozlozit>
                    {krok.nadpis}
                  </h3>
                  <p class="mt-3 mb-0 max-w-[600px] text-lg">{krok.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {/* ================= TIPY — jedna jedoucí řádka ================= */}
  {/* Vyhrála varianta s pohybem, ale místo tří pásů je jedna řádka.
      Kategorie se rozlišují barvou puntíku, ne vlastním pásem — je to
      klidnější a přitom je pořád vidět, že jde o tři různé okruhy.
      Po najetí myší se řádka zastaví, aby se dala přečíst. */}
  <section id="tipy-na-aktivity" class="overflow-hidden bg-pozadi py-16">
    <div class="mx-auto max-w-obsah px-5">
      <h2 class="text-[clamp(1.75rem,3.5vw,2.75rem)]" data-rozlozit>
        Čím se můžete inspirovat?
      </h2>
      <span class="podtrzeni"></span>

      {/* Legenda, ať je barva puntíku čitelná jako kategorie,
          a ne jen jako ozdoba. */}
      <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-2 p-0">
        {
          kategorieTipu.map((kategorie) => (
            <li class="flex items-center gap-2.5">
              <span
                class="h-3 w-3 shrink-0 rounded-full"
                style={`background-color: ${kategorie.barva}`}
              />
              <span class="text-popisek font-semibold">{kategorie.nazev}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="pas-obal mt-10 overflow-hidden">
      <div class="pas gap-4" style="--doba-pasu: 46s">
        {
          [0, 1].map(() =>
            tipyNaStridacku.map((tip) => (
              <span class="flex items-center gap-3 rounded-full border-2 border-merunka-tlumena bg-white px-7 py-4 text-xl whitespace-nowrap">
                <span
                  class="h-2.5 w-2.5 shrink-0 rounded-full"
                  style={`background-color: ${tip.barva}`}
                />
                {tip.nazev}
              </span>
            )),
          )
        }
      </div>
    </div>

    <div class="mx-auto mt-12 max-w-obsah px-5">
      <div class="flex gap-4 rounded-2xl border-l-4 border-merunka bg-plocha-tyrkys p-7">
        <Ikona jmeno="shield-check" velikost={36} />
        <div>
          <h3 class="text-xl">Na co myslet při přípravě</h3>
          <p class="mt-2 mb-0">
            Prioritou je pohoda a bezpečnost všech účastníků. Předem si ověřte
            očekávání seniorů, bezbariérovost prostoru, časovou náročnost
            i případná zdravotní či pohybová omezení. Cílem je klidné
            a příjemné mezigenerační setkání.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ================= ZÁSOBNÍK ================= */}
  {/* Dřív to byl jen odstavec na tmavé ploše. Zásobník je přitom výstup
      celého projektu, tak ho ukazujeme, ne popisujeme: vpravo leží tři
      rozevřené karty, jak budou v databázi vypadat záznamy.

      Obsah karet není vymyšlený — názvy aktivit jsou z podkladů (Tipy na
      aktivity) a údaje na kartách odpovídají tomu, na co se podle podkladů
      bude po akci ptát formulář: pro koho byla vhodná, jaká byla náročnost,
      jaké pomůcky byly potřeba. */}
  <section
    id="zasobnik"
    class="relative overflow-hidden px-5 py-24 text-white"
    style="background: linear-gradient(135deg, var(--color-tyrkys) 0%, #0b4d58 100%)"
  >
    <div class="relative z-10 mx-auto max-w-obsah">
      <div class="grid gap-14 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <span
            class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-popisek font-semibold"
          >
            <Ikona jmeno="sparkles" velikost={18} trida="text-white" />
            Výstup celého projektu
          </span>

          <h2
            class="mt-5 text-[clamp(1.75rem,3.5vw,2.75rem)] text-white"
            data-rozlozit
          >
