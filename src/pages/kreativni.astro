          <div class="mt-8 flex flex-wrap items-center gap-8">
            <p
              class="m-0 inline-flex items-baseline gap-3 rounded-2xl bg-white/10 px-6 py-4"
            >
              <span class="text-3xl font-semibold">1. listopadu</span>
              <span>spouštíme databázi pro celou ČR</span>
            </p>

            {/* Žáci u notebooku — Zásobník staví kroužek na ZŠ Magic Hill,
                takže tu má být vidět, kdo za aplikací stojí. */}
            <div class="pohupuje-se text-white">
              <Ilustrace jmeno="zaci-programuji" sirka={220} kresliSe />
            </div>
          </div>
        </div>

        {/* Rozevřené karty — ukázka záznamu v Zásobníku. */}
        <div class="balicek relative mx-auto h-[380px] w-[470px] max-w-full shrink-0">
          {
            [
              {
                nazev: "Výtvarná dílna",
                kategorie: "Kultura a tvořivost",
                barva: "var(--color-merunka)",
                narocnost: "Nenáročné",
                pomucky: "Papír, pastelky, nůžky",
              },
              {
                nazev: "Zahradní hry",
                kategorie: "Pohyb a pobyt venku",
                barva: "var(--color-tlacitko)",
                narocnost: "Střední",
                pomucky: "Mölkky, pétanque",
              },
              {
                nazev: "Vyprávění příběhů",
                kategorie: "Sdílení a setkávání",
                barva: "var(--color-potvrzeni)",
                narocnost: "Nenáročné",
                pomucky: "Židle, klidný prostor",
              },
            ].map((karta, i) => (
              <article
                class="karta-zasobniku absolute top-6 left-1/2 w-[264px] rounded-2xl bg-white p-6 text-text shadow-2xl"
                style={`--poradi: ${i}`}
              >
                <span
                  class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-popisek font-semibold text-text"
                  style={`background-color: ${karta.barva}`}
                >
                  {karta.kategorie}
                </span>

                <h3 class="mt-4 text-xl">{karta.nazev}</h3>

                <dl class="mt-4 space-y-2 text-popisek">
                  <div class="flex gap-2">
                    <dt class="font-semibold">Vhodné pro:</dt>
                    <dd class="m-0">Senioři i děti</dd>
                  </div>
                  <div class="flex gap-2">
                    <dt class="font-semibold">Náročnost:</dt>
                    <dd class="m-0">{karta.narocnost}</dd>
                  </div>
                  <div class="flex gap-2">
                    <dt class="font-semibold">Pomůcky:</dt>
                    <dd class="m-0">{karta.pomucky}</dd>
                  </div>
                </dl>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ================= MAPKA PŘIHLÁŠENÝCH AKCÍ ================= */}
  {/* Hned za Zásobníkem a před Registrací. Je to jediné místo na stránce,
      kde jsou živá data, ne sliby — důkaz, že se projekt opravdu děje.
      Má být vidět dřív, než se člověk rozhoduje o přihlášení.
      Komponenta si nese vlastní <section id="mapa">, takže ji stejně jako
      ostatní sekce chytne skript s najížděním na konci stránky. */}
  <Mapa />

  {/* ================= PODPORA ================= */}
  <section id="podpora" class="bg-pozadi px-5 py-16">
    <div class="mx-auto max-w-obsah">
      {/* Dvě persony po stranách nadpisu. Nejsou to ozdoba pro ozdobu —
          ukazují, koho se projekt týká, a drží stejnou váhu čáry jako ikony
          na zbytku webu. Na mobilu se schovají, tam by braly místo textu. */}
      <div class="flex items-end justify-between gap-8">
        <div>
          <h2 class="text-[clamp(1.75rem,3.5vw,2.75rem)]" data-rozlozit>
            Jakou podporu od nás získáte?
          </h2>
          <span class="podtrzeni"></span>
        </div>

        <div class="hidden shrink-0 items-end gap-2 text-tyrkys md:flex">
          <Ilustrace jmeno="babicka" sirka={130} kresliSe />
          <Ilustrace jmeno="dedecek" sirka={130} kresliSe />
        </div>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-3">
        <article class="naklon rounded-2xl border border-merunka-tlumena bg-white p-7">
          <Ikona jmeno="message-circle" velikost={36} />
          <h3 class="mt-4 text-xl">Konzultace programu</h3>
          <p class="mt-3 mb-0">
            Nejste si jistí vhodností aktivity? Rádi s vámi nápad zkonzultujeme.
          </p>
        </article>

        <article class="naklon rounded-2xl border border-merunka-tlumena bg-white p-7">
          <Ikona jmeno="map-pin" velikost={36} />
          <h3 class="mt-4 text-xl">Pomoc s nasměrováním</h3>
          <p class="mt-3 mb-0">
            Pokud váháte, koho v okolí oslovit, pokusíme se vás propojit
            se seniorskými organizacemi.
          </p>
        </article>

        <article class="naklon rounded-2xl border border-merunka-tlumena bg-white p-7">
          <Ikona jmeno="award" velikost={36} />
          <h3 class="mt-4 text-xl">Certifikát a zařazení do losování</h3>
          <p class="mt-3 mb-0">
            Ocenění pro žáky a možnost získat věcné odměny pro vaši třídu
            či skupinu.
          </p>
        </article>
      </div>
    </div>
  </section>

  {/* ================= REGISTRACE ================= */}
  <section id="registrace" class="bg-plocha-tyrkys px-5 py-20">
    <div class="mx-auto max-w-obsah">
      <h2 class="text-[clamp(1.75rem,3.5vw,2.75rem)]" data-rozlozit>
        Registrace a poplatek
      </h2>
      <span class="podtrzeni"></span>

      <div class="mt-12 grid gap-10 lg:grid-cols-[340px_1fr] lg:items-start">
        <div class="space-y-5">
          <div class="rounded-2xl bg-white p-7">
            <p class="m-0 text-popisek">Registrační poplatek</p>
            <p class="mt-1 mb-0 text-5xl font-semibold text-tyrkys">500 Kč</p>
          </div>

          <div class="rounded-2xl bg-white p-7">
            <h3 class="text-xl">Na co je poplatek určen?</h3>
            <p class="mt-2 mb-0">
              Tato částka slouží k pokrytí nákladů spojených s celkovou
              organizací a koordinací projektu, vývojem a technickým zajištěním
              aplikace „Zásobník nápadů" a dalšími nezbytnými provozními náklady
              na realizaci akce.
            </p>
          </div>

          <div class="rounded-2xl bg-white p-7">
            <h3 class="text-xl">Platba a fakturace</h3>
            <p class="mt-2 mb-0">
              Platbu lze pohodlně provést pomocí QR kódu nebo standardním
              bankovním převodem. Systém vám po dokončení registrace v případě
              potřeby automaticky vystaví fakturu pro účetnictví
              školy/organizace.
            </p>
          </div>
        </div>

        <FormularKrokovy />
      </div>
    </div>
  </section>

  {/* ================= KE STAŽENÍ A KONTAKT ================= */}
  <section id="ke-stazeni" class="bg-pozadi px-5 py-16">
    <div class="mx-auto max-w-obsah">
      <h2 class="text-[clamp(1.75rem,3.5vw,2.75rem)]" data-rozlozit>
        Ke stažení a kontakt
      </h2>
      <span class="podtrzeni"></span>

      <div class="mt-10">
        {/* [DOPLNIT: kompletní leták k akci v PDF] */}
        <Tlacitko odkaz="#ke-stazeni" varianta="vedlejsi" trida="magnet">
          <Ikona jmeno="file-text" velikost={20} />
          Stáhnout kompletní leták k akci v PDF (pro pořadatele)
        </Tlacitko>
      </div>

      <div
        class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-4 rounded-2xl border-l-4 border-merunka bg-plocha-tyrkys p-7"
      >
        <div>
          <h3 class="text-xl">Nevíte si rady?</h3>
          <p class="mt-1 mb-0">Ozvěte se nám, ráda poradí {OSOBA}.</p>
        </div>

        <div class="flex flex-wrap gap-x-8 gap-y-3">
          <a
            href={`tel:${TELEFON_ODKAZ}`}
            class="flex min-h-11 items-center gap-2 text-lg font-semibold text-tyrkys no-underline"
          >
            <Ikona jmeno="phone" velikost={22} />
            {TELEFON_ZOBRAZIT}
          </a>

          <a
            href={`mailto:${EMAIL}`}
            class="flex min-h-11 items-center gap-2 text-lg font-semibold text-tyrkys no-underline"
          >
            <Ikona jmeno="mail" velikost={22} />
            {EMAIL}
          </a>
        </div>
      </div>

      <Poradatele poradi={3} />
    </div>
  </section>
</Layout>

<script>
  // ==========================================================================
  // Kreativní verze — všechna interakce
  //
  // Každý blok je samostatný. Když se některý efekt vyhodí, ostatní běží dál.
  // Při prefers-reduced-motion se nespustí nic z pohybových věcí, jen obsah
  // zůstane rovnou viditelný.
  // ==========================================================================

  const chceMenePohybu = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  // --- Ukazatel průběhu čtení ---------------------------------------------
  (function pruhPostupu() {
    const pruh = document.querySelector<HTMLElement>("#pruh-postupu");
    if (!pruh || chceMenePohybu) return;

    function prekresli() {
      const vyska = document.body.scrollHeight - window.innerHeight;
      const podil = vyska > 0 ? window.scrollY / vyska : 0;
      pruh!.style.transform = `scaleX(${Math.min(podil, 1)})`;
    }

    prekresli();
    window.addEventListener("scroll", prekresli, { passive: true });
  })();

  // --- Světlo sledující myš ------------------------------------------------
  (function svetloMysi() {
    const svetlo = document.querySelector<HTMLElement>("#svetlo-mysi");
    if (!svetlo || chceMenePohybu) return;
    if (window.matchMedia("(hover: none)").matches) return;

    let cilX = window.innerWidth / 2;
    let cilY = window.innerHeight / 2;
    let x = cilX;
    let y = cilY;

    window.addEventListener(
      "pointermove",
      (u) => {
        cilX = u.clientX;
        cilY = u.clientY;
      },
      { passive: true },
    );

    // Světlo kurzor dohání se zpožděním, ať to není trhané.
    (function krok() {
      x += (cilX - x) * 0.06;
      y += (cilY - y) * 0.06;
      svetlo!.style.left = `${x}px`;
      svetlo!.style.top = `${y}px`;
      requestAnimationFrame(krok);
    })();
  })();

  // --- Odhalování nadpisů po slovech --------------------------------------
  (function slovaVNadpisech() {
    const nadpisy = document.querySelectorAll<HTMLElement>("[data-rozlozit]");

    nadpisy.forEach((nadpis) => {
      // Text rozsekáme na slova a každé zabalíme, ať jde animovat zvlášť.
      // Vnořené prvky (např. <span class="block">) zpracujeme taky.
      const rozlozUzel = (uzel: Node) => {
        if (uzel.nodeType === Node.TEXT_NODE) {
          const slova = (uzel.textContent ?? "").split(/(\s+)/);
          const zlomek = document.createDocumentFragment();

          slova.forEach((cast) => {
            if (/^\s+$/.test(cast) || cast === "") {
              zlomek.appendChild(document.createTextNode(cast));
              return;
            }
            const obal = document.createElement("span");
            obal.className = "slovo";
            obal.textContent = cast;
            zlomek.appendChild(obal);
          });

          uzel.parentNode?.replaceChild(zlomek, uzel);
          return;
        }

        if (uzel.nodeType === Node.ELEMENT_NODE) {
          Array.from(uzel.childNodes).forEach(rozlozUzel);
        }
      };

      Array.from(nadpis.childNodes).forEach(rozlozUzel);
    });

    const slova = document.querySelectorAll<HTMLElement>(".slovo");

    if (chceMenePohybu) {
      slova.forEach((s) => s.classList.add("je-videt"));
      return;
    }

    const pozorovatel = new IntersectionObserver(
      (zaznamy) => {
        zaznamy.forEach((zaznam) => {
          if (!zaznam.isIntersecting) return;

          const nadpis = zaznam.target as HTMLElement;
          const jehoSlova = nadpis.querySelectorAll<HTMLElement>(".slovo");
          jehoSlova.forEach((slovo, i) => {
            window.setTimeout(() => slovo.classList.add("je-videt"), i * 45);
          });
          pozorovatel.unobserve(nadpis);
        });
      },
      { rootMargin: "0px 0px -100px 0px", threshold: 0.1 },
    );

    nadpisy.forEach((n) => pozorovatel.observe(n));
  })();

  // --- Podtržení nadpisů ---------------------------------------------------
  (function podtrzeni() {
    // Spolu s podtržením odhalujeme i obrysové ilustrace — obojí se má
    // vykreslit, až když na to člověk dojede.
    const cary = document.querySelectorAll<HTMLElement>(
      ".podtrzeni, .kresli-se",
    );

    if (chceMenePohybu) {
      cary.forEach((c) => c.classList.add("je-videt"));
      return;
    }

    const pozorovatel = new IntersectionObserver(
      (zaznamy) => {
        zaznamy.forEach((zaznam) => {
          if (!zaznam.isIntersecting) return;
          zaznam.target.classList.add("je-videt");
          pozorovatel.unobserve(zaznam.target);
        });
      },
      { threshold: 0.1 },
    );

    cary.forEach((c) => pozorovatel.observe(c));
  })();

  // --- Naklánění karet za kurzorem ----------------------------------------
  (function naklonKaret() {
    if (chceMenePohybu) return;
    if (window.matchMedia("(hover: none)").matches) return;

    document.querySelectorAll<HTMLElement>(".naklon").forEach((karta) => {
      karta.addEventListener("pointermove", (u) => {
        const r = karta.getBoundingClientRect();
        const px = (u.clientX - r.left) / r.width - 0.5;
        const py = (u.clientY - r.top) / r.height - 0.5;
        // Výchylka schválně malá — přehnaný náklon působí lacině.
        karta.style.transform = `perspective(900px) rotateX(${-py * 6}deg) rotateY(${px * 6}deg) translateY(-4px)`;
      });

      karta.addEventListener("pointerleave", () => {
        karta.style.transform = "";
      });
    });
  })();

  // --- Magnetická tlačítka -------------------------------------------------
  (function magnetickaTlacitka() {
    if (chceMenePohybu) return;
    if (window.matchMedia("(hover: none)").matches) return;

    document.querySelectorAll<HTMLElement>(".magnet").forEach((tlacitko) => {
      tlacitko.addEventListener("pointermove", (u) => {
        const r = tlacitko.getBoundingClientRect();
        const px = u.clientX - (r.left + r.width / 2);
        const py = u.clientY - (r.top + r.height / 2);
        // Max 6 px, ať se tlačítko dá pořád trefit.
        tlacitko.style.transform = `translate(${px * 0.15}px, ${py * 0.15}px)`;
      });

      tlacitko.addEventListener("pointerleave", () => {
        tlacitko.style.transform = "";
      });
    });
  })();

  // --- Kreslení cesty mezi kroky ------------------------------------------
  (function kresleniCesty() {
    const cesta = document.querySelector<SVGPathElement>("#cesta");
    const obal = document.querySelector<HTMLElement>("#cesta-obal");
    if (!cesta || !obal) return;

    const delka = cesta.getTotalLength();
    cesta.style.setProperty("--delka-cesty", String(delka));

    if (chceMenePohybu) {
      cesta.style.strokeDashoffset = "0";
      return;
    }

    function prekresli() {
      const r = obal!.getBoundingClientRect();
      // 0 = sekce přichází zdola, 1 = odchází nahoru
      const podil = 1 - (r.bottom - window.innerHeight * 0.5) / r.height;
      const omezeny = Math.max(0, Math.min(1, podil));
      cesta!.style.strokeDashoffset = String(delka * (1 - omezeny));
    }

    prekresli();
    window.addEventListener("scroll", prekresli, { passive: true });
    window.addEventListener("resize", prekresli, { passive: true });
  })();

  // --- Rozbalovací důvody (varianta D) ------------------------------------
  // První je otevřený, ať je hned vidět, o co jde. Ostatní se rozbalí
  // kliknutím. Zavírat ostatní schválně nebudeme — porovnávat dva důvody
  // vedle sebe je legitimní a nucené zavírání by tomu bránilo.
  (function rozbalovaciDuvody() {
    document
      .querySelectorAll<HTMLButtonElement>(".rozbalovac")
      .forEach((tlacitko) => {
        tlacitko.addEventListener("click", () => {
          const jeOtevreny = tlacitko.getAttribute("aria-expanded") === "true";
          tlacitko.setAttribute("aria-expanded", String(!jeOtevreny));
        });
      });
  })();

  // --- Zvýraznění právě čteného důvodu (varianta E) -----------------------
  (function aktivniDuvod() {
    const duvody = document.querySelectorAll<HTMLElement>(".duvod-e");
    const pocitadlo = document.querySelector<HTMLElement>("#pocitadlo-duvodu");
    if (duvody.length === 0) return;

    if (chceMenePohybu) {
      duvody.forEach((d) => d.classList.add("je-aktivni"));
      return;
    }

    const pozorovatel = new IntersectionObserver(
      (zaznamy) => {
        zaznamy.forEach((zaznam) => {
          const prvek = zaznam.target as HTMLElement;
          prvek.classList.toggle("je-aktivni", zaznam.isIntersecting);

          if (zaznam.isIntersecting) {
            const poradi = prvek.dataset.poradiDuvodu;
            if (pocitadlo) {
              pocitadlo.textContent = `${poradi} z ${duvody.length}`;
            }
          }
        });
      },
      // Úzký pruh uprostřed obrazovky — aktivní je vždy jen jeden.
      { rootMargin: "-40% 0px -40% 0px" },
    );

    duvody.forEach((d) => pozorovatel.observe(d));
  })();

  // --- Plynulý příchod sekcí ----------------------------------------------
  // Aby scrollování působilo jako pochod, ne jako listování dokumentem.
  (function najizdeniSekci() {
    const sekce = document.querySelectorAll<HTMLElement>("section[id]");

    sekce.forEach((s, i) => {
      // Hero necháváme být — ten je vidět hned a neměl by naskakovat.
      if (i === 0) return;
      s.classList.add("sekce-najizdi");
    });

    const kNajezdu = document.querySelectorAll<HTMLElement>(".sekce-najizdi");

    if (chceMenePohybu) {
      kNajezdu.forEach((s) => s.classList.add("je-videt"));
      return;
    }

    const pozorovatel = new IntersectionObserver(
      (zaznamy) => {
        zaznamy.forEach((zaznam) => {
          if (!zaznam.isIntersecting) return;
          zaznam.target.classList.add("je-videt");
          pozorovatel.unobserve(zaznam.target);
        });
      },
      { rootMargin: "0px 0px -120px 0px", threshold: 0.05 },
    );

    kNajezdu.forEach((s) => pozorovatel.observe(s));
  })();

  // --- Přepínač úvodní ilustrace (jen pro hlasování) ----------------------
  (function prepinacHero() {
    const obal = document.querySelector<HTMLElement>("#prepinac-hero");
    if (!obal) return;

    const tlacitka = obal.querySelectorAll<HTMLButtonElement>("[data-volba-hero]");
    const obrazky = document.querySelectorAll<HTMLElement>("[data-hero-ilustrace]");

    tlacitka.forEach((tlacitko) => {
      tlacitko.addEventListener("click", () => {
        const volba = tlacitko.dataset.volbaHero;

        obrazky.forEach((obrazek) => {
          obrazek.hidden = obrazek.dataset.heroIlustrace !== volba;
        });

        tlacitka.forEach((t) =>
          t.setAttribute("aria-pressed", String(t === tlacitko)),
        );
      });
    });
  })();

</script>
