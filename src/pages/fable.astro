---
/**
 * FABLE — stránka postavená od nuly, po svém.
 *
 * KONCEPT „NIT"
 * Stránkou se táhne meruňková nakreslená nit — nit mezi dvěma generacemi.
 * Podtrhne slovo „nezapomíná" v hero, stane se páteří čtyř kroků (kreslí
 * se podle scrollu) a končí u registračního formuláře. Obrysové ilustrace
 * se kreslí stejným tahem, takže celá stránka mluví jazykem tahu pera.
 *
 * POŘADÍ SEKCÍ se od podkladů liší v jednom: mapa přihlášených akcí je
 * zařazená PŘED registraci. Je to sociální důkaz — „jiní už do toho šli" —
 * a ten patří těsně před rozhodnutí, ne za něj.
 *
 * Dramaturgie: přesvědčit (důvody + manifest) → ukázat zvládnutelnost
 * (kroky, tipy, podpora) → co po akci zůstane (Zásobník) → kdo už jde
 * do toho (mapa) → akce (registrace) → kontakt.
 *
 * TEXTY: doslova z podklady/texty.md — nepřepisují se a nezkracují.
 * Chybějící podklady jsou označené [DOPLNIT: …] v komentářích komponent.
 *
 * NEPOUŽÍVÁ Layout.astro: stránka má vlastní hlavičku, vlastní rytmus
 * najíždění a tělo potřebuje třídu .stranka-fable pro odvozené odstíny.
 * Sdílené kusy (formulář, mapa, pořadatelé, patička, přepisy z
 * administrace) se ale berou hotové — jsou odzkoušené naostro.
 */
import "../styles/global.css";
import "../styles/fable.css";

import PrepisyObsahu from "../components/admin/PrepisyObsahu.astro";
import Paticka from "../components/Paticka.astro";
import PrepinacVariant from "../components/PrepinacVariant.astro";
import Mapa from "../components/Mapa.astro";

import Hlavicka from "../components/fable/Hlavicka.astro";
import Hero from "../components/fable/Hero.astro";
import Duvody from "../components/fable/Duvody.astro";
import Kroky from "../components/fable/Kroky.astro";
import Tipy from "../components/fable/Tipy.astro";
import Podpora from "../components/fable/Podpora.astro";
import Zasobnik from "../components/fable/Zasobnik.astro";
import Registrace from "../components/fable/Registrace.astro";
import KeStazeni from "../components/fable/KeStazeni.astro";

const titulek =
  "Propojujeme generace — Mezinárodní den seniorů | aktivně spolu";
const popis =
  "Zorganizujte přátelské mezigenerační setkání ve svém okolí a oslavte " +
  "Mezinárodní den seniorů v týdnu kolem 1. 10. Registrace pro školy, " +
  "firemní týmy, neziskovky i jednotlivce.";
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulek}</title>
    <meta name="description" content={popis} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Písmo s přednačtením, ať text neposkočí po dotažení fontu. -->
    <link
      rel="preload"
      href="/fonty/source-sans-3-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonty/source-sans-3-latin-ext.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:title" content={titulek} />
    <meta property="og:description" content={popis} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />

    {/* Texty upravené v administraci (/admin/) se doplní i sem. */}
    <PrepisyObsahu />

    {/* Bez JavaScriptu se najíždění nikdy nespustí — obsah proto musí
        být viditelný rovnou, jinak by stránka zůstala prázdná. */}
    <noscript>
      <style>
        .f-najezd,
        .najezd {
          opacity: 1;
          transform: none;
        }

        .podtrzeni {
          transform: scaleX(1);
        }

        /* Papírky si bez skriptu nechávají klidový náklon (pravidlo výš
           by jim ho vzalo) a kolečka kroků i kousky nitě v obočí sekcí
           jsou viditelné rovnou. */
        .f-papirek.f-najezd {
          transform: rotate(var(--f-sklon, 0deg));
        }

        .f-pop {
          opacity: 1;
          scale: none;
        }

        .f-najezd:not(.je-videt) .f-obor::before {
          transform: none;
        }
      </style>
    </noscript>
  </head>

  <body class="stranka-fable">
    <!-- Přeskočení na obsah pro čtečky obrazovky a ovládání z klávesnice. -->
    <a
      href="#obsah"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-tyrkys focus:px-4 focus:py-2 focus:text-white"
    >
      Přeskočit na obsah
    </a>
    <PrepinacVariant aktivni="fable" />

    <Hlavicka />

    <main id="obsah">
      <Hero />
      <Duvody />
      <Kroky />
      <Tipy />
      <Podpora />
      <Zasobnik />
      <Mapa />
      <Registrace />
      <KeStazeni />
    </main>

    <Paticka />

    <script>
      // ======================================================================
      // Najíždění obsahu při scrollu.
      //
      // Obsluhuje vlastní třídy stránky (.f-najezd, kreslení nití a ilustrací
      // při scrollu) i třídy převzatých komponent (.najezd, .podtrzeni
      // z formuláře, mapy a pořadatelů) — jeden pozorovatel pro všechno.
      //
      // Jen jednou: po odhalení prvek přestáváme sledovat, animace se
      // neopakuje při scrollu zpět. Při prefers-reduced-motion se
      // pozorovatel vůbec nespouští a všechno se rovnou odhalí.
      // ======================================================================
      const chceMenePohybu = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const prvky = document.querySelectorAll<HTMLElement>(
        ".f-najezd, .najezd, .podtrzeni, .f-nit-scroll, .f-kresli-scroll, .f-pop",
      );

      if (chceMenePohybu) {
        prvky.forEach((prvek) => prvek.classList.add("je-videt"));
      } else {
        const pozorovatel = new IntersectionObserver(
          (zaznamy) => {
            zaznamy.forEach((zaznam) => {
              if (!zaznam.isIntersecting) return;

              const prvek = zaznam.target as HTMLElement;

              // Prvky jedné sekce naskakují se zpožděním 70 ms po sobě.
              const poradi = Number(prvek.dataset.poradi ?? 0);
              window.setTimeout(
                () => prvek.classList.add("je-videt"),
                poradi * 70,
              );

              pozorovatel.unobserve(prvek);
            });
          },
          {
            // Spustí se, až je prvek kousek uvnitř obrazovky.
            rootMargin: "0px 0px -70px 0px",
            threshold: 0.1,
          },
        );

        prvky.forEach((prvek) => pozorovatel.observe(prvek));
      }

      // ------------------------------------------------------------------
      // Scroll-driven efekty v prohlížečích bez scroll-driven animací
      // ------------------------------------------------------------------
      // Chrome a Edge kreslí nit a posouvají hloubkové vrstvy samy podle
      // posunu stránky (viz fable.css). Safari a Firefox to zatím neumí,
      // takže jim totéž dopočítáme tady a předáme jako `--dojeto` od 0
      // do 1. CSS si z toho udělá posun čárky nebo souřadnici — vlastnost
      // je stejná, jen se k ní jde jinudy.
      //
      // Tři režimy podle toho, co prvek dělá:
      //   pater   dlouhá páteř kroků — dojíždí, zatímco JEJÍ SEKCE prochází
      //           obrazovkou; rozsah je užší než celý průchod, ať je nit
      //           hotová dřív, než sekce odjede pryč
      //   predel  krátký steh přes hranici sekcí — hotový, než jeho spodek
      //           dojede do půlky obrazovky (odpovídá `cover 0–60 %`)
      //   prubeh  hloubková vrstva (.f-par) — 0 při vjezdu zespodu, 1 při
      //           odjezdu nahoru (odpovídá `cover 0–100 %`)
      //
      // Všechno počítá jeden posluchač přes requestAnimationFrame. Když je
      // pohyb zakázaný, nespouští se nic: nit zůstane vykreslená celá
      // a vrstvy stojí — správný klidový stav, ne chyba.
      if (
        !chceMenePohybu &&
        !CSS.supports("animation-timeline", "view()")
      ) {
        type Rezim = "pater" | "predel" | "prubeh";
        const polozky: { cil: Element; zdroj: Element; rezim: Rezim }[] = [];

        const pater = document.querySelector<SVGPathElement>(
          ".f-nit-pater path",
        );
        const sekcePatere = pater?.closest("section");
        if (pater && sekcePatere) {
          polozky.push({ cil: pater, zdroj: sekcePatere, rezim: "pater" });
        }

        document
          .querySelectorAll<SVGSVGElement>(".f-nit-predel")
          .forEach((nit) =>
            polozky.push({ cil: nit, zdroj: nit, rezim: "predel" }),
          );

        document
          .querySelectorAll<HTMLElement>(".f-par")
          .forEach((vrstva) =>
            polozky.push({ cil: vrstva, zdroj: vrstva, rezim: "prubeh" }),
          );

        if (polozky.length > 0) {
          let naplanovano = false;

          const prepocitej = () => {
            naplanovano = false;
            const vyska = window.innerHeight;

            for (const { cil, zdroj, rezim } of polozky) {
              const r = zdroj.getBoundingClientRect();
              let podil: number;

              if (rezim === "pater") {
                const zacatek = vyska * 0.95;
                const konec = -r.height * 0.25;
                podil = (zacatek - r.top) / (zacatek - konec);
              } else if (rezim === "predel") {
                podil = (vyska - r.top) / (0.6 * (vyska + r.height));
              } else {
                podil = (vyska - r.top) / (vyska + r.height);
              }

              (cil as HTMLElement).style.setProperty(
                "--dojeto",
                String(Math.max(0, Math.min(1, podil))),
              );
            }
          };

          const naplanuj = () => {
            if (naplanovano) return;
            naplanovano = true;
            window.requestAnimationFrame(prepocitej);
          };

          prepocitej();
          window.addEventListener("scroll", naplanuj, { passive: true });
          window.addEventListener("resize", naplanuj, { passive: true });
        }
      }

      // ------------------------------------------------------------------
      // Šipka v hero: jakmile se návštěvník pohne, uhne nastupující niti.
      // Při vypnutém pohybu zůstává na místě pořád.
      // ------------------------------------------------------------------
      if (!chceMenePohybu) {
        const sipka = document.querySelector<HTMLElement>(".f-sipka-obal");

        if (sipka) {
          let schovana = false;

          const prepniSipku = () => {
            const ma = window.scrollY > 80;
            if (ma === schovana) return;
            schovana = ma;
            sipka.classList.toggle("je-pryc", ma);
          };

          prepniSipku();
          window.addEventListener("scroll", prepniSipku, { passive: true });
        }
      }

      // ------------------------------------------------------------------
      // Smyčky v hero (plování tvarů, houpání šipky) běží jen na obrazovce.
      // Mimo ni se pozastaví — ušetřený výkon je znát hlavně na telefonu.
      // ------------------------------------------------------------------
      const hero = document.querySelector<HTMLElement>(".f-hero");

      if (hero) {
        const uspavac = new IntersectionObserver((zaznamy) => {
          zaznamy.forEach((zaznam) =>
            hero.classList.toggle("je-uspany", !zaznam.isIntersecting),
          );
        });

        uspavac.observe(hero);
      }
    </script>
  </body>
</html>
