---
/**
 * Pořadatelé akce — plná informace o obou organizacích.
 *
 * Tohle je JEDINÉ místo na webu, kde jsou organizace popsané a kde jsou na ně
 * kontakty. Patička o nich záměrně mlčí: dřív tam byla věta „Akci pořádá
 * organizace… ve spolupráci se…" plus loga s odkazy a zadavatel právem vytkl,
 * že je to dvakrát to samé. Když sem někdy budeš chtít přidat další údaj
 * o pořadateli, patří sem, ne do patičky.
 *
 * PROČ JE TO SAMOSTATNÁ KOMPONENTA: původně to bylo napsané přímo v uzemněné
 * verzi, takže kreativní a animovaná verze zůstaly úplně bez log i popisů
 * a nikdo si toho dlouho nevšiml. Teď to všechny verze berou odsud a nemůžou
 * se rozejít.
 *
 * Texty popisů i webové adresy jsou doslova z podklady/texty.md, sekce 8.
 * Nepřepisují se a nezkracují.
 *
 * LOGA POŘADATELŮ: stačí je nakopírovat do `public/obrazky/` pod názvem
 * `logo-prave-ted` a `logo-magic-hill` (svg, png, jpg i webp). Šablona si sama
 * všimne, že soubor přibyl. Dokud tam není, vysází se název typograficky
 * a NEVZNIKNE rozbitý obrázek.
 * POZOR: /obrazky/logo.png je logo PROJEKTU (Mezigeneračně aktivně spolu),
 * ne log pořadatelů. Jako logo organizace se použít nesmí.
 */
import { existsSync } from "node:fs";
import Ikona from "./Ikona.astro";

interface Props {
  /** true = boxy sedí na bílé ploše, tak dostanou tyrkysové pozadí */
  naBilem?: boolean;
  /** Pořadí pro postupné naskakování prvků v sekci */
  poradi?: number;
}

const { naBilem = false, poradi = 3 } = Astro.props;

/**
 * Údaje, které zadavatel zatím nedodal, se na webu vůbec neukazují.
 * Vypisovat návštěvníkovi „[DOPLNIT: telefon]" je horší než ten řádek
 * vynechat — v kódu placeholder zůstává, takže ho hledání najde.
 */
const dodano = (hodnota: string) => !hodnota.startsWith("[DOPLNIT");

/**
 * Vrátí cestu k logu, ale jen když soubor opravdu leží v public/obrazky/.
 *
 * Kdybychom cestu napsali natvrdo dřív, než logo dorazí, měl by web na dvou
 * místech rozbitý obrázek. Takhle se do té doby tiše použije typografická
 * varianta a po nakopírování souboru se logo objeví samo.
 */
function logoKdyzExistuje(nazev: string): string | null {
  const slozka = new URL("../../public/obrazky/", import.meta.url);
  for (const pripona of ["svg", "png", "jpg", "jpeg", "webp"]) {
    if (existsSync(new URL(`${nazev}.${pripona}`, slozka))) {
      return `/obrazky/${nazev}.${pripona}`;
    }
  }
  return null;
}

const poradatele = [
  {
    nazev: "Právě teď! o.p.s.",
    logo: logoKdyzExistuje("logo-prave-ted"),
    popis:
      "Právě teď! o.p.s. udává směr modernímu, zdravému a aktivnímu stárnutí. Prostřednictvím moderních aktivizačních programů pomáhá seniorům žít aktivní život.",
    osoba: "[DOPLNIT: jméno kontaktní osoby — Právě teď! o.p.s.]",
    email: "[DOPLNIT: e-mail — Právě teď! o.p.s.]",
    telefon: "[DOPLNIT: telefon — Právě teď! o.p.s.]",
    webPopis: "www.pravetedops.cz",
    webOdkaz: "https://www.pravetedops.cz",
  },
  {
    nazev: "ZŠ Magic Hill",
    logo: logoKdyzExistuje("logo-magic-hill"),
    popis:
      "ZŠ s rozšířenou výukou jazyků Magic Hill, s.r.o., kde díky individuálnímu přístupu v malých kolektivech a důrazu na jazyky děti získávají znalosti a dovednosti pro úspěch v 21. století.",
    osoba: "[DOPLNIT: jméno kontaktní osoby — ZŠ Magic Hill]",
    email: "[DOPLNIT: e-mail — ZŠ Magic Hill]",
    telefon: "[DOPLNIT: telefon — ZŠ Magic Hill]",
    webPopis: "www.magic-hill.cz",
    webOdkaz: "https://www.magic-hill.cz",
  },
];
---

<div class="najezd mt-14" data-poradi={poradi}>
  <h3 class="text-xl">Pořadatelé akce</h3>
  <p class="mt-1 mb-0">
    Akci pořádá organizace Právě teď! o.p.s. ve spolupráci se ZŠ Magic Hill.
  </p>
</div>

<div class="mt-6 grid gap-6 md:grid-cols-2">
  {
    poradatele.map((organizace, index) => (
      <div
        class:list={[
          "najezd rounded-xl border border-merunka-tlumena p-6",
          naBilem ? "bg-plocha-tyrkys" : "bg-white",
        ]}
        data-poradi={poradi + 1 + index}
      >
        {/* Logo prokliknutelné na web organizace. Plocha má pevnou výšku,
            takže se rozvržení nehne, ať je uvnitř obrázek nebo název. */}
        <a
          href={organizace.webOdkaz}
          rel="noopener"
          class="flex h-16 max-w-[220px] items-center no-underline"
          aria-label={`Přejít na web organizace ${organizace.nazev}`}
        >
          {organizace.logo ? (
            <img
              src={organizace.logo}
              alt={`Logo ${organizace.nazev}`}
              class="max-h-full w-auto"
            />
          ) : (
            <span class="text-2xl leading-tight font-semibold text-tyrkys">
              {organizace.nazev}
            </span>
          )}
        </a>

        <p class="mt-4 mb-0">{organizace.popis}</p>

        {/* Kontakty nejsou červené — červená na webu znamená výhradně
            tlačítko. Klikací řádky mají min. 44 px na výšku, aby se daly
            trefit prstem i méně jistou rukou. */}
        <ul class="mt-4 list-none space-y-1 p-0">
          {dodano(organizace.osoba) && (
            <li class="flex min-h-11 items-center gap-3">
              <Ikona jmeno="user" velikost={22} />
              <span>{organizace.osoba}</span>
            </li>
          )}

          {dodano(organizace.email) && (
            <li>
              <a
                href={`mailto:${organizace.email}`}
                class="flex min-h-11 items-center gap-3 font-semibold text-tyrkys no-underline"
              >
                <Ikona jmeno="mail" velikost={22} />
                {organizace.email}
              </a>
            </li>
          )}

          {dodano(organizace.telefon) && (
            <li>
              <a
                href={`tel:${organizace.telefon}`}
                class="flex min-h-11 items-center gap-3 font-semibold text-tyrkys no-underline"
              >
                <Ikona jmeno="phone" velikost={22} />
                {organizace.telefon}
              </a>
            </li>
          )}

          <li>
            <a
              href={organizace.webOdkaz}
              rel="noopener"
              class="flex min-h-11 items-center gap-3 font-semibold text-tyrkys no-underline"
            >
              <Ikona jmeno="globe" velikost={22} />
              {organizace.webPopis}
            </a>
          </li>
        </ul>
      </div>
    ))
  }
</div>
