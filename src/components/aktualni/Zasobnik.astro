---
/**
 * Zásobník nápadů — druhá tmavá plocha stránky.
 *
 * Inkoustová plocha tu není náhodou: Zásobník je odkaz, který po akci
 * zůstane — nejtrvalejší část celého projektu. Tmavá plocha mu dává
 * váhu a zároveň rámuje scénu se žákem, který aplikaci staví.
 *
 * SCÉNA „ŽÁK DRŽÍ KARTY": dřív tu vedle sebe stály dva nápady, které
 * spolu nemluvily — obrysová postava a samostatné karty. Teď je to
 * jedna scéna: žák drží v ruce vějíř tří karet, jak budou vypadat
 * záznamy v Zásobníku. Ruku mu nedokreslujeme — karty držené směrem
 * k divákovi ruku přirozeně zakrývají, takže držení vzniká překryvem
 * a natočením, ne zásahem do kresby (ta má jednotný tah a nesmí se
 * kazit). Vějíř se rozevírá od jeho dlaně vzhůru k textu sekce, který
 * popisuje přesně ta pole, co jsou na kartách vidět.
 *
 * Sekce stojí na tmavé ploše, proto je kresba světlá.
 */
import Nit from "./Nit.astro";

---

<section id="zasobnik" class="f-tma relative px-5 py-20 sm:py-28">
  {/* Teplý odlesk v hloubce inkoustu — pluje pomaleji než scroll,
      stejně jako v manifestu. Text stojí pevně. */}
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="f-par f-tma-akcent" style="--f-hloubka: 26"></div>
  </div>

  {/* Steh přes hranici s Podporou — nit se noří do tmavé plochy. */}
  <Nit
    varianta="predel"
    trida="f-nit-predel relative z-10 mx-auto -mt-34 mb-2 block h-28 w-auto sm:-mt-42"
  />

  <div
    class="relative mx-auto grid max-w-obsah items-center gap-12 lg:grid-cols-[7fr_5fr]"
  >
    <div>
      <div class="f-najezd" data-poradi="0">
        <p class="f-obor">Zásobník nápadů</p>
        <h2 class="f-titulek mt-4">Co je to Zásobník nápadů?</h2>
      </div>

      <p class="f-najezd mt-8 mb-0 max-w-[60ch]" data-poradi="1">
        Jde o webovou aplikaci, kterou v rámci IT/AI kroužku vytvářejí žáci
        ZŠ Magic Hill z Říčan u Prahy.
      </p>

      <p class="f-najezd mt-5 mb-0 max-w-[60ch]" data-poradi="2">
        Po realizaci vaší akce vyplníte jednoduchý formulář s popisem akce
        (pro koho byla akce vhodná, jaká byla náročnost, jaké pomůcky byly
        potřeba) a nahrajete fotografie. Od 1. listopadu tak vznikne veřejně
        přístupná databáze plná ověřené inspirace pro organizátory podobných
        akcí z celé ČR.
      </p>
    </div>

    {/* Scéna: dva žáci u počítače.

        Zadavatel si vyžádal jen kresbu, bez vějíře karet, které tu předtím
        držel obrysový žák. Karty ukazovaly, jak budou záznamy v Zásobníku
        vypadat — ta informace tím ze sekce zmizela. Kdyby chyběla, patří
        zpátky pod text, ne zase k postavě.

        Kresba je světlá schválně: sekce stojí na tmavé ploše a černá čára
        by na ní zanikla. Barvu má napečenou v souboru, protože rastr se
        na rozdíl od obrysové kresby nedá obarvit podle podkladu. */}
    <div
      class="f-par relative mx-auto w-full max-w-[430px]"
      style="--f-hloubka: -14"
    >
      <img
        src="/obrazky/kresba-zaci-u-pocitace.webp"
        alt="Dva žáci u počítače programují aplikaci"
        width="660"
        height="673"
        class="f-najezd h-auto w-full"
        data-poradi="1"
        loading="lazy"
      />
    </div>
  </div>
</section>

