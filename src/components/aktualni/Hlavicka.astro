---
/**
 * Hlavička stránky.
 *
 * Nad hero sedí průsvitně na gradientu, po odscrollování dostane hranu
 * a stín (třída .je-plna, přidává skript níž).
 *
 * MENU NA TELEFONU se sbaluje pod tři čárky. Dřív tu odkazy jely vodorovně
 * a posouvaly se prstem — schválně, protože viditelný odkaz je spolehlivější
 * než schovaný. Zadavatel chce tři čárky, tak jsou tady; posuvná řádka odkazů
 * je totiž na dotyku poloviční ovladač, protože není nijak vidět, že se s ní
 * dá hýbat, a poslední dva odkazy tak nikdo nenajde.
 *
 * BEZ JAVASCRIPTU MUSÍ ZŮSTAT ODKAZY DOSTUPNÉ. Sbalení proto zapíná až
 * třída `f-menu-ano`, kterou na <body> přidává skript. Dokud tam není,
 * chová se hlavička přesně jako dřív — odkazy jsou vidět a dají se posouvat.
 * Kdyby se sbalovalo rovnou z šablony, znamenal by nespuštěný skript menu,
 * které nejde otevřít, a stránku bez jediné navigace.
 *
 * ČERVENÉ TLAČÍTKO SE POD ČÁRKY NESCHOVÁVÁ ÚPLNĚ: je první položkou
 * v otevřeném menu a hned pod hlavičkou na něj stejně kouká velké tlačítko
 * v úvodní obrazovce.
 *
 * Klikací plochy drží nejméně 44 px na výšku (min-h-11).
 */
import Tlacitko from "../Tlacitko.astro";

interface Props {
  /**
   * Hlavička stojí i na podstránkách (Zásobník nápadů, zápis po akci).
   * Tam kotvy musí vést zpátky na hlavní stránku: „#mapa" → „/#mapa".
   */
  naHlavniStrance?: boolean;
}

const { naHlavniStrance = true } = Astro.props;
const predpona = naHlavniStrance ? "" : "/";

/**
 * Tlačítko vpravo nahoře. Na ostrém webu zatím vede na registraci.
 * Výměna za „Zásobník nápadů" přijde až po odsouhlasení zadavatelkou.
 */
const tlacitko = { odkaz: `${predpona}#registrace`, text: "Chci se zapojit" };

const odkazy = [
  { cil: "#proc-se-zapojit", popis: "Proč se zapojit" },
  { cil: "#jak-to-funguje", popis: "Jak to funguje" },
  { cil: "#tipy-na-aktivity", popis: "Tipy na aktivity" },
  { cil: "#zasobnik", popis: "Zásobník nápadů" },
  { cil: "#mapa", popis: "Mapa akcí" },
  { cil: "#ke-stazeni", popis: "Kontakt" },
];
---

<header class="f-hlavicka" id="f-hlavicka">
  <div class="mx-auto flex max-w-obsah items-center gap-4 px-5 py-3">
    <a
      href={naHlavniStrance ? "#obsah" : "/"}
      class="shrink-0"
      aria-label={naHlavniStrance ? "Mezigeneračně aktivně spolu" : "Mezigeneračně aktivně spolu, hlavní stránka"}
    >
      <img
        src="/obrazky/logo.png"
        alt="Mezigeneračně aktivně spolu"
        width="170"
        height="50"
        class="h-auto w-[150px] sm:w-[170px]"
      />
    </a>

    {/* Tři čárky. V šabloně je tlačítko schované atributem `hidden` a odkrývá
        ho až skript — bez něj by to bylo tlačítko, které nic neotevře. */}
    <button
      type="button"
      id="f-menu-tlacitko"
      class="f-menu-tlacitko"
      aria-controls="f-menu"
      aria-expanded="false"
      hidden
    >
      <span class="f-menu-carky" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
      <span class="sr-only">Menu</span>
    </button>

    <nav
      id="f-menu"
      class="f-menu f-hlavicka-odkazy -mx-2 flex min-w-0 flex-1 gap-1 overflow-x-auto px-2"
      aria-label="Sekce stránky"
    >
      {
        odkazy.map((odkaz) => (
          <a
            href={predpona + odkaz.cil}
            data-kotva={odkaz.cil}
            class="flex min-h-11 shrink-0 items-center rounded-full px-3.5 text-popisek whitespace-nowrap text-text no-underline transition-colors duration-150 hover:bg-plocha-tyrkys"
          >
            {odkaz.popis}
          </a>
        ))
      }

      {/* Tlačítko v otevřeném menu. Nad lg ho CSS skryje — tam stojí
          samostatně vpravo v liště (níž). */}
      <div class="f-menu-cta">
        <Tlacitko odkaz={tlacitko.odkaz} trida="w-full justify-center px-5 py-3">
          {tlacitko.text}
        </Tlacitko>
      </div>
    </nav>

    <div class="hidden shrink-0 lg:block">
      <Tlacitko odkaz={tlacitko.odkaz} trida="px-5 py-2">{tlacitko.text}</Tlacitko>
    </div>
  </div>
</header>

<script>
  // --- Menu pod třemi čárkami ---------------------------------------------
  // Sbalování zapíná až tenhle skript. Dokud třída na <body> není, jsou
  // odkazy vidět tak jako dřív — nespuštěný skript tedy neznamená stránku
  // bez navigace, jen menu, které se nesbaluje.
  const tlacitkoMenu = document.getElementById("f-menu-tlacitko");
  const menu = document.getElementById("f-menu");
  const naDotyk = window.matchMedia("(max-width: 63.999rem)");

  if (tlacitkoMenu && menu) {
    document.body.classList.add("f-menu-ano");
    tlacitkoMenu.removeAttribute("hidden");

    function otevriZavri(otevrit: boolean) {
      menu!.classList.toggle("je-otevrene", otevrit);
      tlacitkoMenu!.setAttribute("aria-expanded", String(otevrit));
    }

    function zavri(vratitFokus = false) {
      if (tlacitkoMenu!.getAttribute("aria-expanded") !== "true") return;
      otevriZavri(false);
      // Fokus se vrací na tlačítko jen když menu zavřela klávesnice.
      // Po klepnutí na odkaz by ho to naopak odtrhlo od místa, kam se
      // stránka právě posunula.
      if (vratitFokus) tlacitkoMenu!.focus();
    }

    tlacitkoMenu.addEventListener("click", () => {
      otevriZavri(tlacitkoMenu.getAttribute("aria-expanded") !== "true");
    });

    // Klepnutí na odkaz menu zavře — jinak by zůstalo viset přes sekci,
    // na kterou stránka právě odscrollovala.
    menu.querySelectorAll("a").forEach((odkaz) => {
      odkaz.addEventListener("click", () => zavri());
    });

    document.addEventListener("keydown", (udalost) => {
      if (udalost.key === "Escape") zavri(true);
    });

    // Klepnutí mimo hlavičku menu zavře. Bez toho se na telefonu zavírá
    // jedině znovu tlačítkem, což nikdo nezkusí.
    document.addEventListener("click", (udalost) => {
      const cil = udalost.target as Node;
      if (!menu.contains(cil) && !tlacitkoMenu.contains(cil)) zavri();
    });

    // Při zvětšení okna nad lg se z menu zase stane vodorovná lišta.
    // Kdyby zůstal příznak „otevřeno", tlačítko by po zmenšení hlásilo
    // rozbalený stav, který nikde není vidět.
    naDotyk.addEventListener("change", (udalost) => {
      if (!udalost.matches) otevriZavri(false);
    });
  }

  // --- Hrana lišty po odscrollování ---------------------------------------
  // Nad hero je lišta průsvitná bez hrany, po pár pixelech scrollu dostane
  // linku a stín, aby se oddělila od obsahu, přes který jede.
  const hlavicka = document.getElementById("f-hlavicka");

  function prepniHranu() {
    hlavicka?.classList.toggle("je-plna", window.scrollY > 12);
  }

  prepniHranu();
  window.addEventListener("scroll", prepniHranu, { passive: true });

  // --- Zvýraznění sekce, ve které návštěvník právě je ---------------------
  const odkazy = document.querySelectorAll<HTMLAnchorElement>(
    ".f-hlavicka-odkazy [data-kotva]",
  );
  const sekce = Array.from(odkazy)
    .map((odkaz) => document.querySelector<HTMLElement>(odkaz.dataset.kotva!))
    .filter((prvek): prvek is HTMLElement => prvek !== null);

  if (sekce.length > 0) {
    const pozorovatel = new IntersectionObserver(
      (zaznamy) => {
        zaznamy.forEach((zaznam) => {
          if (!zaznam.isIntersecting) return;

          const id = `#${zaznam.target.id}`;
          odkazy.forEach((odkaz) => {
            if (odkaz.dataset.kotva === id) {
              odkaz.setAttribute("aria-current", "true");
            } else {
              odkaz.removeAttribute("aria-current");
            }
          });
        });
      },
      // Sekce se počítá jako aktivní, když je v horní třetině obrazovky.
      { rootMargin: "-20% 0px -70% 0px" },
    );

    sekce.forEach((prvek) => pozorovatel.observe(prvek));
  }
</script>
