---
/**
 * Hero — otevření stránky.
 *
 * Teze celé stránky v jednom pohledu: obrovský titulek, ve kterém nit
 * podtrhne slovo „nezapomíná", vedle něj se sama nakreslí ilustrace
 * dítěte a seniora. Emoce: tohle stojí za to udělat a je to zvládnutelné.
 *
 * TEXTY: doslova z podklady/texty.md, sekce 1. Titulek je rozlámaný do
 * řádků kvůli sazbě, znění se nemění. Z dvojice navržených CTA je použité
 * „Jdu do toho!" — má v sobě víc energie a míří i na Gen Z.
 *
 * POHYB: nástup po načtení řídí CSS (třída .f-vzestup + pořadí --z),
 * takže funguje i bez JavaScriptu a při prefers-reduced-motion se vypne
 * úplně — obsah je pak vidět okamžitě.
 */
import Ikona from "../Ikona.astro";
import Tlacitko from "../Tlacitko.astro";
import Ilustrace from "../Ilustrace.astro";
import Nit from "./Nit.astro";

/**
 * Čtyři kreslené scény, které se v úvodní obrazovce střídají.
 *
 * Vznikly z jedné předlohy od zadavatele (mřížka 2×2) — rozřezal ji
 * scripts/kresby-z-predlohy.py. Všechny čtyři mají SHODNÝ rozměr plátna
 * a postavy stojí na společné spodní hraně; kdyby to tak nebylo, stránka
 * by při každé výměně poskočila a postava by poletovala nahoru a dolů.
 *
 * Popis je jeden pro celou střídačku (viz `role="img"` níž), ne po scénách.
 * Kdyby měla každá scéna vlastní `alt`, měnil by se popis obrázku pod rukama
 * někomu, kdo si ho nechává předčítat — a bez varování, protože se to děje
 * samo od sebe.
 */
const kresby = [
  { soubor: "kresba-babicka-kytice.webp", popis: "seniorka s kyticí" },
  { soubor: "kresba-babicka-s-detmi.webp", popis: "seniorka povídá s dětmi" },
  { soubor: "kresba-babicka-darek.webp", popis: "seniorka s dárkem" },
  { soubor: "kresba-babicka-kvetina.webp", popis: "seniorka s květinou v květináči" },
];

/* Čtyři skupiny, pro které akce je — mikro-copy pod tlačítky z podkladů. */
const skupiny = [
  { ikona: "school", popis: "Školy a školky" },
  { ikona: "briefcase", popis: "Kolektivy a firmy" },
  { ikona: "hand-heart", popis: "Neziskovky a komunity" },
  { ikona: "sparkles", popis: "Jednotlivci a mladí nadšenci" },
];
---

<section id="uvod" class="f-hero px-5 pt-12 pb-8 sm:pt-16">
  {/* Velké měkké tvary v pozadí — pomalé plování, nic přes text.
      Každý má vlastní paralaxní obal s jinou hloubkou (--f-hloubka),
      takže se při scrollu pozadí rozvrství a hero dostane prostor. */}
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="f-par absolute inset-0" style="--f-hloubka: 30">
      <div class="f-blob f-blob-a"></div>
    </div>
    <div class="f-par absolute inset-0" style="--f-hloubka: 16">
      <div class="f-blob f-blob-b"></div>
    </div>
  </div>

  <div
    class="relative mx-auto grid max-w-obsah items-center gap-12 lg:grid-cols-[7fr_5fr]"
  >
    <div>
      <p class="f-obor f-vzestup" style="--z: 0">Mezinárodní den seniorů</p>

      <h1 class="f-hero-nadpis mt-6">
        <span class="f-hero-nadech f-vzestup" style="--z: 1">
          Propojujeme generace.
        </span>
        {/* Bez čárky za „setkání" na výslovné přání zadavatele.
            Pravopisně tam čárka patří — uvozuje vedlejší větu vztažnou
            („na které se nezapomíná") a ta se v češtině odděluje vždycky.
            V podklady/texty.md i v ostatních verzích webu proto zůstala. */}
        <span class="f-vzestup block" style="--z: 2">Vytvořte setkání</span>
        <span class="f-vzestup block" style="--z: 3">
          na které se
          <span class="relative inline-block">
            nezapomíná<Nit
              varianta="podtrz"
              trida="f-nit-nacteni absolute -bottom-2 left-0 w-full"
            />
          </span>.
        </span>
      </h1>

      <p class="f-vzestup mt-8 max-w-[58ch]" style="--z: 4">
        Ať už vedete školu, tvoříte mladý pracovní kolektiv, působíte
        v neziskovce nebo chcete s přáteli udělat něco smysluplného — oslavte
        s námi Mezinárodní den seniorů (v týdnu kolem 1. 10.). Zorganizujte
        přátelské mezigenerační setkání ve svém okolí. A poté zanechte svou
        stopu a staňte se součástí celostátního Zásobníku nápadů.
      </p>

      <div class="f-vzestup mt-8 flex flex-wrap items-center gap-4" style="--z: 5">
        <Tlacitko odkaz="#registrace" trida="px-8 py-3.5 text-lg">
          Jdu do toho!
          <Ikona jmeno="arrow-right" velikost={22} trida="text-white" />
        </Tlacitko>

        {/* [DOPLNIT: informační leták v PDF — zatím vede na sekci Ke stažení] */}
        <Tlacitko odkaz="#ke-stazeni" varianta="vedlejsi">
          <Ikona jmeno="download" velikost={20} />
          Stáhnout informační leták (PDF)
        </Tlacitko>
      </div>

    </div>

    {/* Dítě a senior — ilustrace se po načtení sama nakreslí, jako by ji
        někdo maloval jedním tahem. Celý sloupec má zápornou hloubku:
        při scrollu stoupá o chlup rychleji než text, hero tím dostane
        vrstvy. */}
    <div class="f-par relative mx-auto w-full max-w-[420px]" style="--f-hloubka: -12">
      <div class="f-hero-kruh f-vzestup" style="--z: 2" aria-hidden="true"></div>
      <div class="relative px-6 pt-10 text-tyrkys">
        {/* Kreslené scény od zadavatele. Jsou to rastry, ne obrysy, takže se
            nedají „kreslit tahem" jako předchozí postavy ani obarvovat —
            místo toho celá střídačka jemně nastoupí. Pozadí mají odbarvené
            na průhledné, takže sedí na jakoukoli plochu.

            CELÁ SKUPINA JE PRO ČTEČKU OBRAZOVKY JEDEN OBRÁZEK: `role="img"`
            s jedním popisem, jednotlivé kresby mají `alt=""`. Jinak by se
            v předčítané podobě stránky objevily čtyři obrázky tam, kde je
            vidět jeden, a popis by se sám od sebe měnil.

            Bez JavaScriptu se nic nestřídá a zůstane vidět první kresba —
            třídu `je-videt` má rovnou v šabloně, ne až od skriptu. */}
        <div
          class="f-strid f-vzestup"
          style="--z: 3"
          role="img"
          aria-label="Kreslené scény ze setkání generací: seniorka s kyticí, při povídání s dětmi, s dárkem a s květinou"
        >
          {
            kresby.map((kresba, poradi) => (
              <img
                src={`/obrazky/${kresba.soubor}`}
                alt=""
                width="523"
                height="336"
                class:list={["f-strid-kresba", poradi === 0 && "je-videt"]}
                fetchpriority={poradi === 0 ? "high" : undefined}
                decoding="async"
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>

  {/* Komu akce patří — čtyři skupiny z podkladů. Štítky nastupují po sobě
      jako poslední takt hero choreografie.

      Sedí pod mřížkou přes celou šířku, ne v textovém sloupci. Ten je užší
      než stránka a čtyři štítky se v něm lámaly do dvou řádků po dvou. */}
  <ul
    class="relative mx-auto mt-10 flex max-w-obsah list-none flex-wrap justify-center gap-2 p-0 lg:flex-nowrap lg:justify-start"
  >
    {
      skupiny.map((skupina, poradi) => (
        <li
          class="f-vzestup flex min-h-11 items-center gap-2 rounded-full border border-merunka-tlumena bg-white/80 px-4 text-popisek whitespace-nowrap"
          style={`--z: ${6 + poradi * 0.6}`}
        >
          <Ikona jmeno={skupina.ikona} velikost={18} />
          {skupina.popis}
        </li>
      ))
    }
  </ul>

  {/* Pozvání dál — jen jemně se houpající šipka, žádný text navíc.
      Jakmile se návštěvník pohne, šipka svou práci odvedla a uhne
      nastupující niti (třídu .je-pryc přidává skript v fable.astro). */}
  <div
    class="f-sipka-obal relative mt-8 flex justify-center text-tyrkys"
    aria-hidden="true"
  >
    <Ikona jmeno="chevron-down" velikost={30} trida="f-sipka" />
  </div>
</section>

<script>
  // ==========================================================================
  // Střídání kreslených scén v úvodní obrazovce
  //
  // Prolínání samo dělá CSS, tady se jen přehazuje třída `je-videt`. Skript
  // nic nezobrazuje ani neskrývá napevno — když nepoběží, zůstane vidět první
  // kresba, protože tu třídu má už v šabloně.
  //
  // KDY SE STŘÍDAČKA ZASTAVÍ:
  //   * při zakázaném pohybu se vůbec nerozjede (a když si ho návštěvník
  //     zakáže až za běhu, zastaví se hned),
  //   * na neaktivní kartě prohlížeče — jinak by na pozadí běžela donekonečna
  //     pro nikoho,
  //   * když na ni najedeš myší nebo se do ní dostaneš tabulátorem.
  //
  // Zastavení najetím ale NENÍ plnohodnotné ovládání: kdo je na dotykovém
  // displeji nebo chodí po stránce klávesnicí, střídačku zastavit nemůže.
  // Stejné omezení má řádka s tipy na aktivity a čeká na stejné rozhodnutí —
  // pořádné řešení je viditelné tlačítko „zastavit", a to je zásah do vzhledu.
  // ==========================================================================
  const stridacka = document.querySelector<HTMLElement>(".f-strid");
  const kresby = stridacka
    ? [...stridacka.querySelectorAll<HTMLElement>(".f-strid-kresba")]
    : [];

  if (stridacka && kresby.length > 1) {
    const dotazNaPohyb = window.matchMedia("(prefers-reduced-motion: reduce)");

    // Dvě vteřiny na kresbu podle zadání. Je to rychlé tempo, a proto je
    // prolnutí v CSS zkrácené na 650 ms — kdyby trvalo jako dřív skoro
    // vteřinu a půl, další výměna by začala dřív, než by se ta předchozí
    // stihla dokončit, a v úvodu by pořád visely dvě kresby přes sebe.
    const PAUZA = 2000;

    let ktera = 0;
    let casovac: ReturnType<typeof setInterval> | null = null;

    function dalsi() {
      kresby[ktera].classList.remove("je-videt");
      ktera = (ktera + 1) % kresby.length;
      kresby[ktera].classList.add("je-videt");
    }

    function jed() {
      if (casovac !== null || dotazNaPohyb.matches || document.hidden) return;
      casovac = setInterval(dalsi, PAUZA);
    }

    function stuj() {
      if (casovac === null) return;
      clearInterval(casovac);
      casovac = null;
    }

    stridacka.addEventListener("mouseenter", stuj);
    stridacka.addEventListener("mouseleave", jed);
    stridacka.addEventListener("focusin", stuj);
    stridacka.addEventListener("focusout", jed);

    document.addEventListener("visibilitychange", () =>
      document.hidden ? stuj() : jed(),
    );

    dotazNaPohyb.addEventListener("change", () =>
      dotazNaPohyb.matches ? stuj() : jed(),
    );

    jed();
  }
</script>
