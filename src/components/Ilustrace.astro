        <path d="M78 158 h44"/>
        <path d="M72 170 h28"/>
        <path d="M44 178 h152 l10 12 h-172 z"/>
      </>
    )
  }

  {
    jmeno === "mezigeneracne" && (
      <>
        {/* Dítě a senior vedle sebe — mezigenerační setkání. */}
        <circle cx="56.0" cy="110.0" r="23.0"/>
        <path d="M42.9 108.6 a4.6 4.6 0 0 1 9.2 0"/>
        <path d="M59.9 108.6 a4.6 4.6 0 0 1 9.2 0"/>
        <path d="M48.6 119.2 a7.4 5.9 0 0 0 14.7 0"/>
        <path d="M50.9 131.2 V138.1 C38.3 139.4 10.0 147.7 10.0 171.0 V198.0"/>
