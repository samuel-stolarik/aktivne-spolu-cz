        <circle cx="140.7" cy="161.3" r="6"/>
        <circle cx="137.4" cy="151.2" r="6"/>
        <path d="M96 164 q10 16 20 26"/>
        <path d="M120 154 q0 18 -2 36"/>
        <path d="M146 166 q-8 16 -20 24"/>
      </>
    )
  }

  {
    jmeno === "zaci-programuji" && (
      <>
        {/* Dva žáci za notebookem — Zásobník staví kroužek na ZŠ Magic Hill. */}
        <circle cx="76.0" cy="72.0" r="24.0"/>
        <path d="M62.3 70.6 a4.8 4.8 0 0 1 9.6 0"/>
        <path d="M80.1 70.6 a4.8 4.8 0 0 1 9.6 0"/>
        <path d="M68.3 81.6 a7.7 6.1 0 0 0 15.4 0"/>
