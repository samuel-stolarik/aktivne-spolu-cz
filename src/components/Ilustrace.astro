---
/**
 * Linkové ilustrace postav.
 *
 * Záměrně obrysové, ne kreslené obrázky. Zadavatel chtěl „spíš obrys
 * a grafiku než obrázek" — plné ilustrace by si vynutily ilustrátora
 * a jednotný styl by se držel těžko.
 *
 * KONSTRUKCE — všechny postavy jsou postavené stejně, aby držely proporce:
 *
 *   1. HLAVA je kružnice, KRK dvě krátké svislé čáry pod bradou a RAMENA
 *      dvě křivky, které z krku vycházejí. Dřív ramena začínala v prázdnu
 *      a hlava nad nimi plavala.
 *   2. Mezi krčními čarami NENÍ vodorovná spojnice — udělala by kostičku,
 *      jako by měl člověk obojek.
 *   3. DRDOL je kroužek PŘESNĚ dosedající na hlavu: vzdálenost středů se
 *      rovná součtu poloměrů, takže se dotýkají v jediném bodě. Obrys nemá
 *      výplň, takže jakýkoli překryv by byl vidět jako dvojitá čára.
 *      Ze stejného důvodu tu není vlasový oblouk přes temeno.
 *   4. Postavy vedle sebe mají mezi rameny mezeru, aby se čáry nekřížily.
 *
 * Souřadnice se generovaly ze společné předlohy a pak zkontrolovaly
 * vykreslením do obrázku — od oka se tohle nakreslit nedá.
 *
 * Barvu řídí `currentColor`. Červená se v ilustracích nepoužívá —
 * ta patří tlačítkům.
 *
 * ANIMACE: s třídou `kresli-se` se obrys vykreslí, jako by ho někdo
 * maloval. Respektuje prefers-reduced-motion (viz kreativni.css).
 */
interface Props {
  /** "dvojice" | "babicka" | "dedecek" | "senior-s-kytici" | "zaci-programuji" | "mezigeneracne" */
  jmeno: string;
  /** Šířka v pixelech; výška dopočítá poměr */
  sirka?: number;
  /** true = obrys se při zobrazení vykreslí */
  kresliSe?: boolean;
  trida?: string;
}

const { jmeno, sirka = 240, kresliSe = false, trida = "" } = Astro.props;
---

<svg
  viewBox="0 0 240 200"
  width={sirka}
  height={(sirka * 200) / 240}
  role="img"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["shrink-0", kresliSe && "kresli-se", trida]}
>
  {
    jmeno === "dvojice" && (
      <>
        {/* Dvojice seniorů vedle sebe. */}
        <circle cx="58.0" cy="48.4" r="8.6"/>
        <circle cx="58.0" cy="84.0" r="27.0"/>
        <path d="M42.6 82.4 a5.4 5.4 0 0 1 10.8 0"/>
        <path d="M62.6 82.4 a5.4 5.4 0 0 1 10.8 0"/>
        <path d="M49.4 94.8 a8.6 6.9 0 0 0 17.3 0"/>
        <path d="M52.1 108.8 V116.9 C37.2 118.6 6.0 128.3 6.0 161.5 V198.0"/>
        <path d="M63.9 108.8 V116.9 C78.8 118.6 110.0 128.3 110.0 161.5 V198.0"/>
        <circle cx="182.0" cy="90.0" r="27.0"/>
