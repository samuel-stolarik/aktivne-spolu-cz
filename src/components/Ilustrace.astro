        <path d="M173.4 100.8 a8.6 6.9 0 0 0 17.3 0"/>
        <path d="M176.1 114.8 V122.9 C161.2 124.6 130.0 134.3 130.0 164.2 V198.0"/>
        <path d="M187.9 114.8 V122.9 C202.8 124.6 234.0 134.3 234.0 164.2 V198.0"/>
      </>
    )
  }

  {
    jmeno === "babicka" && (
      <>
        {/* Babička s drdolem a brýlemi — jedna persona. */}
        <circle cx="120.0" cy="25.2" r="12.8"/>
        <circle cx="120.0" cy="78.0" r="40.0"/>
        <circle cx="105.2" cy="75.6" r="11.6"/>
        <circle cx="134.8" cy="75.6" r="11.6"/>
