---
/**
 * Linkové ilustrace postav.
 *
 * Záměrně obrysové, ne kreslené obrázky. Zadavatel chtěl „spíš obrys
 * a grafiku než obrázek" — plné ilustrace by si vynutily ilustrátora
 * a jednotný styl by se držel těžko.
 *
 * Všechny postavy jsou vedené jako HLAVA A RAMENA. Zkoušel jsem i postavy
 * v celku, ale bez výplně z nich byli panáčci a props (květina) se scvrkl
 * na terčík. Poprsí drží stejnou váhu čáry, čte se i v malém a vypadá
 * záměrně.
 *
 * Postavy se staví z kružnic a oblouků se stejnou tloušťkou čáry. Nesnaží
 * se vypadat jako kresba, ale jako značka: jdou obarvit jednou barvou,
 * zvětšit na jakoukoliv velikost a nerozsypou se.
 *
 * Barvu řídí `currentColor`. Červená se v ilustracích nepoužívá —
 * ta patří tlačítkům.
 *
 * ANIMACE: s třídou `kresli-se` se obrys vykreslí, jako by ho někdo
 * maloval. Respektuje prefers-reduced-motion (viz kreativni.css).
 */
interface Props {
  /** "dvojice" | "babicka" | "dedecek" | "mezigeneracne" */
  jmeno: string;
  /** Šířka v pixelech; výška dopočítá poměr */
  sirka?: number;
  /** true = obrys se při zobrazení vykreslí */
  kresliSe?: boolean;
  trida?: string;
}

const { jmeno, sirka = 240, kresliSe = false, trida = "" } = Astro.props;
---

<svg
  viewBox="0 0 240 200"
  width={sirka}
  height={(sirka * 200) / 240}
  role="img"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["shrink-0", kresliSe && "kresli-se", trida]}
>
  {
    jmeno === "dvojice" && (
      <>
        {/* Dvojice seniorů vedle sebe. */}
        {/* Babička — drdol */}
        <circle cx="82" cy="74" r="32" />
        <circle cx="82" cy="34" r="12" />
        <path d="M52 62 a30 30 0 0 1 60 0" />
        <path d="M68 76 a7 7 0 0 1 12 0" />
        <path d="M88 76 a7 7 0 0 1 12 0" />
        <path d="M70 90 a14 12 0 0 0 24 0" />
        <path d="M30 198 v-28 a52 52 0 0 1 104 0 v28" />

        {/* Dědeček */}
        <circle cx="164" cy="80" r="30" />
        <path d="M136 72 a28 22 0 0 1 56 0" />
        <path d="M150 82 a7 7 0 0 1 12 0" />
        <path d="M168 82 a7 7 0 0 1 12 0" />
        <path d="M152 96 a13 11 0 0 0 22 0" />
        <path d="M118 198 v-24 a48 48 0 0 1 96 0 v24" />
      </>
    )
  }

  {
    jmeno === "babicka" && (
      <>
        {/* Babička s brýlemi — jedna persona. */}
        <circle cx="120" cy="82" r="42" />
        <circle cx="120" cy="30" r="16" />
        <path d="M78 68 a42 38 0 0 1 84 0" />
        {/* Brýle */}
        <circle cx="103" cy="84" r="13" />
        <circle cx="137" cy="84" r="13" />
        <path d="M116 84 h8" />
        <path d="M90 80 l-11 -4 M150 80 l11 -4" />
        <path d="M106 106 a16 13 0 0 0 28 0" />
        {/* Ramena */}
        <path d="M44 198 v-24 a76 62 0 0 1 152 0 v24" />
      </>
    )
  }

  {
    jmeno === "dedecek" && (
      <>
        {/* Dědeček s knírkem — druhá persona. */}
        <circle cx="120" cy="84" r="42" />
        <path d="M78 74 a42 34 0 0 1 84 0" />
        {/* Uši */}
        <path d="M78 82 a7 9 0 0 0 0 18" />
        <path d="M162 82 a7 9 0 0 1 0 18" />
        <path d="M100 86 a8 8 0 0 1 14 0" />
        <path d="M126 86 a8 8 0 0 1 14 0" />
        {/* Úsměv. Knírek tu původně byl, ale nad ústy se četl jako svěšená
            pusa a dědeček vypadal, že se mračí. Poznávacím znamením
            proti babičce je pleš a uši, to stačí. */}
        <path d="M104 106 a16 14 0 0 0 32 0" />
        <path d="M44 198 v-24 a76 62 0 0 1 152 0 v24" />
      </>
    )
  }

  {
    jmeno === "mezigeneracne" && (
      <>
        {/* Dítě a senior vedle sebe — mezigenerační setkání. */}
        {/* Dítě, menší a níž */}
        <circle cx="70" cy="98" r="26" />
        <path d="M46 90 a24 20 0 0 1 48 0" />
        <path d="M59 100 a6 6 0 0 1 10 0" />
        <path d="M73 100 a6 6 0 0 1 10 0" />
        <path d="M61 112 a11 9 0 0 0 18 0" />
        <path d="M28 198 v-20 a42 40 0 0 1 84 0 v20" />

        {/* Senior, vyšší */}
        <circle cx="166" cy="66" r="32" />
        <circle cx="166" cy="26" r="12" />
        <path d="M134 54 a32 26 0 0 1 64 0" />
        <path d="M151 68 a7 7 0 0 1 12 0" />
        <path d="M170 68 a7 7 0 0 1 12 0" />
        <path d="M153 82 a13 11 0 0 0 22 0" />
        <path d="M110 198 v-30 a56 52 0 0 1 112 0 v30" />
      </>
    )
  }
</svg>
