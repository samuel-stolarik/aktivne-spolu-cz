---
/**
 * Linkové ilustrace postav.
 *
 * Kresby dodal zadavatel (vznikly v Claude Design podle zadání projektu).
 * Nahradily dřívější postavy, které jsem skládal z kružnic a oblouků —
 * tyhle jsou vedené volnou rukou, mají líce, bradu a vlasy jako skutečný
 * obrys hlavy, ne kolečko s drdolem nalepeným navrch.
 *
 * SPOLEČNÁ PRAVIDLA, na kterých stojí zbytek webu:
 *   - `fill="none"`, barvu řídí `currentColor` — postava se obarví podle
 *     místa, kam se vloží (tyrkysová na světlé ploše, meruňková na tmavé)
 *   - jednotná tloušťka čáry
 *   - **každý tvar má `pathLength="1"`** — díky tomu jde obrys vykreslit
 *     tah po tahu jedním pravidlem v CSS, bez dopočítávání délek
 *
 * Každá postava má vlastní `viewBox`, protože dvojice je širší než
 * samostatná postava. Proto se rozměry berou z tabulky níž a nejsou
 * napevno ve značce `<svg>`.
 *
 * ANIMACE: s třídou `kresli-se` se obrys vykreslí, jako by ho někdo maloval.
 * Respektuje prefers-reduced-motion (viz kreativni.css a animovana.css).
 */
interface Props {
  /**
   * "seniorka" | "seniorka-s-kytici" | "zak" | "zak-s-notebookem" | "dvojice"
   */
  jmeno: string;
  /** Šířka v pixelech; výška dopočítá poměr podle viewBoxu */
  sirka?: number;
  /** true = obrys se při zobrazení vykreslí */
  kresliSe?: boolean;
  trida?: string;
}

const { jmeno, sirka = 240, kresliSe = false, trida = "" } = Astro.props;

// Rozměry výřezu. Dvojice má dvojnásobnou šířku, protože v ní stojí
// dvě postavy vedle sebe.
const vyrez: Record<string, { s: number; v: number; popis: string }> = {
  seniorka: { s: 120, v: 120, popis: "Seniorka" },
  "seniorka-s-kytici": { s: 120, v: 120, popis: "Seniorka s kyticí" },
  zak: { s: 120, v: 120, popis: "Žák" },
  "zak-s-notebookem": { s: 120, v: 120, popis: "Žák s notebookem" },
  dvojice: { s: 240, v: 120, popis: "Seniorka a žák" },
};

const rozmer = vyrez[jmeno] ?? { s: 120, v: 120, popis: "Postava" };
const vyska = (sirka * rozmer.v) / rozmer.s;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${rozmer.s} ${rozmer.v}`}
  width={sirka}
  height={vyska}
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={`${rozmer.popis} — obrysová kresba`}
  class:list={["shrink-0", kresliSe && "kresli-se", trida]}
>
  {/* Dvojice: seniorka vlevo, žák vpravo. Obě postavy jsou kreslené
      ve výřezu 120×120, takže druhou stačí posunout o 120 doprava. */}
  {
    (jmeno === "seniorka" ||
      jmeno === "seniorka-s-kytici" ||
      jmeno === "dvojice") && (
      <g>
        <path pathLength="1" d="M40 42 C39 55 44 64 52 69 C56 71.5 64 71.5 68 69 C76 64 81 55 80 42" />
        <path pathLength="1" d="M40 42 C38 26 46 17 60 17 C74 17 82 26 80 42" />
        <path pathLength="1" d="M49.1 19.4 C46 4 74 4 70.9 19.4" />
        <path pathLength="1" d="M55.5 13 C58 9 62 9 64.5 13" />
        <path pathLength="1" d="M40 33.2 C42 26 48 21.5 55 19.6" />
        <path pathLength="1" d="M39.6 37 C45 30 52 25.5 60 24" />
        <path pathLength="1" d="M41.2 47 C36.5 46 36 55 41.6 55.5" />
        <path pathLength="1" d="M41.6 55.5 C39.6 58.5 40.8 62 43 61.5 C44.8 61 44.6 57.8 41.6 55.5 Z" />
        <path pathLength="1" d="M78.8 47 C83.5 46 84 55 78.4 55.5" />
        <path pathLength="1" d="M78.4 55.5 C80.4 58.5 79.2 62 77 61.5 C75.2 61 75.4 57.8 78.4 55.5 Z" />
        <path pathLength="1" d="M43.5 44.5 C43.5 40.5 46 39.2 50.5 39.4 C55 39.6 56.8 41.2 56.6 45 C56.4 48.8 54 50.6 50 50.4 C46 50.2 43.5 48.5 43.5 44.5 Z" />
        <path pathLength="1" d="M76.5 44.5 C76.5 40.5 74 39.2 69.5 39.4 C65 39.6 63.2 41.2 63.4 45 C63.6 48.8 66 50.6 70 50.4 C74 50.2 76.5 48.5 76.5 44.5 Z" />
        <path pathLength="1" d="M56.7 42.6 C58.5 41.4 61.5 41.4 63.3 42.6" />
        <path pathLength="1" d="M46.8 45.8 Q50.3 42.4 53.8 45.8" />
        <path pathLength="1" d="M66.2 45.8 Q69.7 42.4 73.2 45.8" />
        <path pathLength="1" d="M59 53 C57.5 56.5 58.5 58 60.5 58" />
        <path pathLength="1" d="M54.5 62 C57.5 65.5 62.5 65.5 65.5 62" />
        <path pathLength="1" d="M52.8 69.6 C52.2 74.5 51.8 77.5 51.5 79 C40 81 22 88 16 112" />
        <path pathLength="1" d="M67.2 69.6 C67.8 74.5 68.2 77.5 68.5 79 C80 81 98 88 104 112" />
        <path pathLength="1" d="M52.6 80 C55 88 58 93.5 60 98.5" />
        <path pathLength="1" d="M67.4 80 C65 88 62 93.5 60 98.5" />
        <path pathLength="1" d="M60 100.5 C57 103 58 107 60 107 C62 107 63 103 60 100.5 Z" />
      </g>
    )
  }

  {
    jmeno === "seniorka-s-kytici" && (
      <g>
        <path pathLength="1" d="M94.5 51 C94.5 59.5 85.5 59.5 85.5 51 L88 46.2 L90 50.4 L92 46.2 Z" />
        <path pathLength="1" d="M104.5 39 C104.5 47.5 95.5 47.5 95.5 39 L98 34.2 L100 38.4 L102 34.2 Z" />
        <path pathLength="1" d="M116.5 47 C116.5 55.5 107.5 55.5 107.5 47 L110 42.2 L112 46.4 L114 42.2 Z" />
        <path pathLength="1" d="M90 57.5 C93 64 97 71 99.5 77" />
        <path pathLength="1" d="M100 45.5 C100.5 56 100.2 68 99.9 77" />
        <path pathLength="1" d="M112 53.5 C108 61 103 71 100.4 77" />
      </g>
    )
  }

  {
    (jmeno === "zak" || jmeno === "zak-s-notebookem" || jmeno === "dvojice") && (
      <g transform={jmeno === "dvojice" ? "translate(120 0)" : undefined}>
        <path pathLength="1" d="M43 40 C42 52 46.5 60 53 64.5 C56.5 66.5 63.5 66.5 67 64.5 C73.5 60 78 52 77 40" />
        <path pathLength="1" d="M43 40 C41 26 48 18 60 18 C72 18 79 26 77 40" />
        <path pathLength="1" d="M42.2 36.5 C50 25.5 62 32 70 26.5 C73.5 24 76 29.5 77.5 34" />
        <path pathLength="1" d="M42.7 44 C38.5 43.5 38 51 43 51.8" />
        <path pathLength="1" d="M77.3 44 C81.5 43.5 82 51 77 51.8" />
        <path pathLength="1" d="M49.5 46 Q53 42.6 56.5 46" />
        <path pathLength="1" d="M63.5 46 Q67 42.6 70.5 46" />
        <path pathLength="1" d="M59.5 50 C58.2 53.5 59.2 54.8 61 54.8" />
        <path pathLength="1" d="M54.5 57.5 C57.5 61 62.5 61 65.5 57.5" />
        <path pathLength="1" d="M53.2 64.8 C53 69.5 53.2 71.8 53 73.5 C42 75.5 30 84 27 112" />
        <path pathLength="1" d="M66.8 64.8 C67 69.5 66.8 71.8 67 73.5 C78 75.5 90 84 93 112" />
        <path pathLength="1" d="M53.8 74.5 C57 79.5 63 79.5 66.2 74.5" />
        <path pathLength="1" d="M31.8 95 C37 93.5 42 94.5 44 99" />
        <path pathLength="1" d="M88.2 95 C83 93.5 78 94.5 76 99" />
      </g>
    )
  }

  {
    jmeno === "zak-s-notebookem" && (
      <g>
        <path pathLength="1" d="M89 67 L89 46 L114 42 L114 63 Z" />
        <path pathLength="1" d="M89 67 L95.5 73.5 L118 69.5 L114 63" />
      </g>
    )
  }
</svg>
